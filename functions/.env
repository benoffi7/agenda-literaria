# El ID del calendario no es secreto: es el espejo público de la agenda.
# Lo que sí es secreto (el PAT de GitHub del §8) va a Secret Manager, no acá.
GOOGLE_CALENDAR_ID=68e6037bad1570002e484be4a5a21b6dd052afadef1af6c4cb99946b0d2aaea3@group.calendar.google.com

# §8 — repo que tiene el workflow que rebuildea el sitio
# (.github/workflows/deploy.yml). Tampoco es secreto: es el nombre del repo.
# El PAT que autoriza el repository_dispatch va a Secret Manager como
# GITHUB_TOKEN, y se ata a la Function con `defineSecret` en index.js.
GITHUB_REPO=benoffi7/agenda-literaria
