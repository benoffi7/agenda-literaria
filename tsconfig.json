{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*.ts", "**/*.tsx", "**/*.astro"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      // Lógica pura del evento de Calendar, compartida por la Function y la
      // vista previa del panel: una sola fuente de verdad. Si la vista previa
      // duplicara `construirDescripcion`, mentiría en cuanto las dos copias se
      // separaran. El mismo alias está en astro.config.mjs y vitest.config.ts.
      "@calendario": ["functions/calendario.js"],
      // Ídem con el historial de versiones (§12): el panel compara una versión
      // contra el documento actual con la MISMA función que decide qué se
      // guarda, así no hay dos ideas de "qué campos escribe la máquina".
      "@historial": ["functions/historial.js"],
      // Ídem con la lista blanca de chunks PNG seguros (B-323): el panel y la
      // Function de optimización comparten la misma lista, así una lista
      // negra desactualizada no vuelve a dejar pasar un chunk como `caBX`.
      "@png-chunks-seguros": ["functions/png-chunks-seguros.js"]
    }
  }
}
