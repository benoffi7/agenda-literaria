# Config del SDK web de Firebase. NO es secreta: viaja en el bundle del
# cliente por diseño, y la seguridad la dan las reglas de Firestore (§5.3),
# no el secreto de estos valores. Por eso está versionada — así el deploy no
# necesita configurar nada.
#
# Lo que NUNCA va acá es la service account key del Admin SDK (§5.4).
PUBLIC_FIREBASE_API_KEY=AIzaSyB89-QzenUOn73Obin4WfFp1P-kpQyHLkA
PUBLIC_FIREBASE_AUTH_DOMAIN=agenda-literaria.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=agenda-literaria
PUBLIC_FIREBASE_STORAGE_BUCKET=agenda-literaria.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1038157194972
PUBLIC_FIREBASE_APP_ID=1:1038157194972:web:5b52810ed763c2d3cd7619
# Analítica del panel (docs/09-analitica.md). Sin este valor no se mide nada:
# es uno de los tres portones de `debeMedir`.
PUBLIC_FIREBASE_MEASUREMENT_ID=G-9CFMHSSGRC
PUBLIC_USE_EMULATORS=false
# App Check (B-836) — clave de sitio de reCAPTCHA **Enterprise**, score-based.
# Pública por diseño, como la API key: el navegador la necesita para pedir el
# desafío, y con App Check el assessment lo hace Firebase con las credenciales
# del proyecto, así que no hay clave privada de reCAPTCHA de este lado.
# Sin este valor App Check no se activa y el panel sigue funcionando mientras el
# enforcement esté apagado. Ver docs/02-infraestructura.md → App Check.
PUBLIC_RECAPTCHA_SITE_KEY=6LdnJ7ItAAAAAJ8bhMr3pomloq4Nd9SiyL_3oems
