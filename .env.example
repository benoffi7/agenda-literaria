# ── Cliente (se bundlean, son públicas por diseño) ──────────────
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=agenda-literaria.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=agenda-literaria
PUBLIC_FIREBASE_STORAGE_BUCKET=agenda-literaria.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1038157194972
PUBLIC_FIREBASE_APP_ID=
# Analítica del panel (docs/09-analitica.md). Vacío = no se mide.
# En desarrollo se deja vacío: con PUBLIC_USE_EMULATORS=true tampoco se mide.
PUBLIC_FIREBASE_MEASUREMENT_ID=

# Apunta el cliente a los emuladores en desarrollo
PUBLIC_USE_EMULATORS=true

# ── Build time / Admin SDK — NUNCA al cliente (§5.4) ────────────
# JSON completo de la service account, en una línea. En CI va como secret.
FIREBASE_SERVICE_ACCOUNT=
# Alternativa local: ruta al archivo de la key
GOOGLE_APPLICATION_CREDENTIALS=

# Emuladores para el Admin SDK en build local
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ── Google Calendar (§7) — se usa en el paso 4, no en el panel ───
# Espejo de solo lectura. El ID es público-ish, la key de la service account no.
GOOGLE_CALENDAR_ID=68e6037bad1570002e484be4a5a21b6dd052afadef1af6c4cb99946b0d2aaea3@group.calendar.google.com
# La URL privada del ICS (private-...) es un secreto: NUNCA al repo.
GOOGLE_CALENDAR_ICS_PRIVADO=
