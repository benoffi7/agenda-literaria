node_modules/
dist/
.astro/
.emulador/
*.log
firebase-debug.log
firestore-debug.log
ui-debug.log
.DS_Store

# Borrador de mensaje de commit. Se ignora porque ya se coló al índice una
# vez (`.tmp-msg.txt`, commiteado sin querer en f163e2b y dado de baja el
# 2026-09-03): un `-F .tmp-msg.txt` es cómodo justamente porque el archivo
# queda en la raíz, y sin esta línea vuelve a aparecer en `git status` y
# tarde o temprano en un `add`.
.tmp-msg.txt

# Claves — NUNCA al repo (§5.4)
# .env.production y .env.development SÍ están versionados: la config del SDK
# web es pública por diseño (viaja en el bundle). Lo que no se versiona es
# cualquier archivo con la service account key.
#
# B-213 — esa excepción ya no depende de la memoria: `tests/env-versionados.test.ts`
# recorre TODOS los `.env` del índice de git (los descubre, no los lista) y exige
# que cada clave sea `PUBLIC_*`, una excepción nombrada o esté vacía, y que
# ningún valor tenga forma de secreto. Nunca imprime un valor.
.env
.env.local
.env.*.local
service-account*.json
*-service-account.json

# Caché local del deploy de Hosting
.firebase/

# Functions
functions/node_modules/
# El patrón `.env` de arriba también matchea functions/.env. Se exceptúa: solo
# tiene el ID del calendario, que no es secreto, y sin él un clone nuevo no
# puede deployar la Function. Los secretos van a Secret Manager.
!functions/.env
functions/.env.local
functions/.env.*.local

# Worktrees de subagentes
.claude/worktrees/

# Estado compartido entre los worktrees de los frentes en paralelo.
# Un archivo por frente: seis agentes escribiendo el mismo archivo se pisan.
.estado/
.mdd/
