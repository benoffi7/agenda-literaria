---
/**
 * El bloque corto de «suscribirse», para embeber fuera de su página — B-230.
 *
 * Pensado para la home: quien llega al listado ya vio que hay actividades, y
 * ese es el momento en que ofrecer llevárselas tiene sentido. La página entera
 * de `/suscribirse` no entra ahí, pero el camino de la mayoría —Google— sí, y
 * el resto se alcanza con un enlace.
 *
 * **No lo cablea este componente.** La home tiene otro dueño; acá queda listo
 * para que lo importe y lo ponga donde corresponda.
 *
 * `nivel` existe porque un encabezado no puede elegirse por cómo se ve: dentro
 * de la home este bloque cuelga del `h1` del listado y va como `h2`; si algún
 * día se anida bajo otra sección, va como `h3`. Saltear un nivel deja la página
 * con un índice roto para quien la navega por encabezados.
 */
import { CAMINOS, COMO_FUNCIONA } from '@/lib/suscripcion';
import SuscribirseAccion from '@/components/sitio/SuscribirseAccion.astro';

interface Props {
  nivel?: 2 | 3;
  /**
   * El `id` del encabezado, que es lo que nombra a la sección. Es una prop y no
   * una constante para que embeberlo dos veces en la misma página no produzca
   * dos elementos con el mismo `id` — que deja a un lector de pantalla saltando
   * siempre al primero.
   */
  idTitulo?: string;
}

const { nivel = 2, idTitulo = 'suscribirse-resumen' } = Astro.props;
const Titulo = `h${nivel}` as 'h2' | 'h3';
const google = CAMINOS.google;
---

<section
  aria-labelledby={idTitulo}
  class="rounded-lg border border-borde bg-white/60 p-5 sm:p-6"
>
  <Titulo id={idTitulo} class="font-serif text-xl font-semibold text-tinta">
    Llevate la agenda a tu calendario
  </Titulo>
  <p class="mt-2 max-w-prose text-tinta/80">{COMO_FUNCIONA.entrada}</p>

  <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center">
    <SuscribirseAccion accion={google.accion} />
    <a
      href="/suscribirse"
      class="inline-flex min-h-touch items-center justify-center rounded-md px-2 text-tinta/80 underline decoration-borde underline-offset-4 hover:text-tinta hover:decoration-acento focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-acento"
    >
      Otras formas de suscribirse
    </a>
  </div>
</section>
