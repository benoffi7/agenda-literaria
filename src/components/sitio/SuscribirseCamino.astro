---
/**
 * Un camino de la página «Suscribirse» — B-230, B-253.
 *
 * Los cuatro se pintan con este mismo componente a propósito: si cada uno
 * tuviera su bloque de markup, el que se agregue mañana podría salir sin los
 * pasos, sin el botón o sin el aviso de lector de pantalla, y nada se pondría
 * en rojo. El contenido decide qué dice cada uno; acá se decide una sola vez
 * cómo se ve.
 *
 * El camino que se copia y se pega (`seCopia`) **no lleva botón que navegue**:
 * abrir esa dirección en el navegador descarga un archivo, que es justo lo que
 * sus propios pasos piden no usar. En su lugar va la dirección escrita, que es
 * lo que hace falta pegar del otro lado.
 *
 * El botón de copiar lo agrega el script y no el HTML: sin portapapeles
 * disponible —o sin JavaScript— un botón que no hace nada es peor que no
 * tenerlo, y la dirección se puede seleccionar igual.
 *
 * ── Lo que B-253 cambió, que es solo cómo se ve ───────────────────────────
 * Los pasos numerados eran un `<ol>` con los marcadores del navegador, y en una
 * tarjeta con borde eso se lee como una nota al pie. Ahora el número es una
 * ficha redonda sobre la superficie hundida, del mismo tamaño que el de un
 * encuentro en la página de detalle: **el mismo dato se ve igual en las dos
 * páginas**, que es la mitad de lo que hace que un sitio parezca uno solo.
 */
import type { Camino } from '@/lib/suscripcion';
import SuscribirseAccion from '@/components/sitio/SuscribirseAccion.astro';
import { claseTarjeta, foco } from '@/components/sitio/estilos';

interface Props {
  camino: Camino;
}

const { camino } = Astro.props;
const { accion } = camino;
---

<article class={`p-5 sm:p-6 ${claseTarjeta}`}>
  <h3 class="font-serif text-xl font-semibold text-tinta">{camino.titulo}</h3>
  <p class="mt-1 text-tinta/80">{camino.paraQuien}</p>

  {
    !accion.seCopia && (
      <div class="mt-4">
        <SuscribirseAccion accion={accion} />
      </div>
    )
  }

  {
    accion.seCopia && (
      <div data-copiable class="mt-4">
        <p id={`direccion-${camino.id}`} class="text-sm font-medium text-tinta">
          {accion.texto}
          <span class="sr-only"> ({accion.avisoLector})</span>
        </p>
        <div class="mt-2 flex flex-col gap-2 rounded-md border border-borde bg-papel p-3 sm:flex-row sm:items-center">
          <code
            data-direccion
            aria-labelledby={`direccion-${camino.id}`}
            class="min-w-0 flex-1 overflow-x-auto text-xs break-all text-tinta/80"
          >
            {accion.url}
          </code>
          <button
            type="button"
            data-copiar
            hidden
            class={`min-h-touch shrink-0 rounded-md border border-borde bg-hondo px-4 text-sm font-medium text-tinta transition-colors hover:border-acento hover:text-acento ${foco}`}
          >
            Copiar
          </button>
          <span data-aviso-copia role="status" class="sr-only"></span>
        </div>
      </div>
    )
  }

  {/*
    Los pasos con su número en una ficha: es el patrón de la lista de encuentros
    del detalle, y repetirlo es lo que hace que las dos páginas se lean como el
    mismo sitio. Sigue siendo un `<ol>` —el orden es la información— con los
    marcadores apagados, así que un lector de pantalla lo anuncia como lista
    numerada igual.
  */}
  <ol class="mt-5 flex list-none flex-col gap-3 ps-0">
    {
      camino.pasos.map((paso, i) => (
        <li class="flex min-w-0 gap-3">
          <span
            class="flex size-6 shrink-0 items-center justify-center rounded-full bg-hondo text-xs font-semibold text-tinta/80 tabular-nums"
            aria-hidden="true"
          >
            {i + 1}
          </span>
          <span class="min-w-0 flex-1 text-tinta/80">{paso}</span>
        </li>
      ))
    }
  </ol>

  {
    camino.siSaleMal && (
      <p class="mt-5 border-s-2 border-acento/40 ps-3 text-sm text-tinta/80">{camino.siSaleMal}</p>
    )
  }
</article>

<script>
  /*
   * Copiar la dirección del calendario. Es mejora progresiva: el botón sale del
   * HTML oculto y solo se muestra si el navegador tiene portapapeles. En un
   * contexto sin `navigator.clipboard` —o sin JavaScript— la dirección queda
   * igual a la vista y se puede seleccionar a mano, que es lo que había antes.
   */
  const copiar = navigator.clipboard;

  for (const caja of document.querySelectorAll('[data-copiable]')) {
    const boton = caja.querySelector<HTMLButtonElement>('[data-copiar]');
    const direccion = caja.querySelector('[data-direccion]')?.textContent?.trim();
    const aviso = caja.querySelector('[data-aviso-copia]');
    if (!copiar || !boton || !direccion) continue;

    boton.hidden = false;
    boton.addEventListener('click', async () => {
      try {
        await copiar.writeText(direccion);
        boton.textContent = 'Copiada';
        // El cambio de texto lo ve quien mira; el `role="status"` es para quien
        // no: sin él, tocar el botón no produce ninguna señal audible.
        if (aviso) aviso.textContent = 'Dirección copiada';
      } catch {
        boton.textContent = 'No se pudo copiar';
        if (aviso) aviso.textContent = 'No se pudo copiar la dirección';
      }
      window.setTimeout(() => {
        boton.textContent = 'Copiar';
        if (aviso) aviso.textContent = '';
      }, 3000);
    });
  }
</script>
