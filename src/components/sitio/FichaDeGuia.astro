---
/**
 * El esqueleto de una ficha de la Guía — M-10, D-1196. Lo montan las cuatro
 * `src/pages/guia/<directorio>/[slug].astro`.
 *
 * Lo que es igual en las cuatro vive acá: las migas, el nombre, la portada con
 * su epígrafe, la descripción, los contactos, el resto de la galería, el enlace
 * de vuelta y los dos bloques de JSON-LD. Lo que cambia por entidad entra por
 * los dos slots —`cabecera`, entre el nombre y la portada, y el default, entre la
 * descripción y los contactos— y **los campos siguen decidiéndose en cada
 * página**, desde su view-model. Esto no ve una entidad: recibe textos, `href`
 * ya saneados e imágenes ya proyectadas.
 *
 * Cada página conserva su propio `<Base>`, igual que las de hub con
 * `CuerpoDeHub.astro`: `tests/chrome-del-sitio.test.ts` e `identidad.test.ts`
 * miran las páginas que usan el layout, y una página sin `<Base>` se saltearía
 * esos chequeos en silencio.
 *
 * ── Cero JavaScript ───────────────────────────────────────────────────────
 * No hay islands: quien cae acá llega de Google o de un link y tiene una sola
 * pregunta —dónde queda y cómo le escribo—.
 *
 * ── Todas las imágenes, no solo la portada (B-296) ───────────────────────
 * La portada va arriba y las demás al final del contenido, como en el detalle de
 * una actividad, y sin imagen **no hay hueco** (§7.6).
 */
import { claseAfiche, claseEnlace } from '@/components/sitio/estilos';
import { RUTA_GUIA } from '@/lib/rutasPublicas';

interface Enlace {
  texto: string;
  href: string;
}

interface ImagenDeFicha {
  url: string;
  epigrafe: string;
  ancho: number | null;
  alto: number | null;
}

interface Props {
  nombre: string;
  descripcion: string;
  imagenes: readonly ImagenDeFicha[];
  seccion: Enlace;
  volver: Enlace;
  /**
   * Los canales, en el orden en que sirven. Llegan **ya como `href` saneado**
   * (`urlSegura`, `handleInstagram`) o `null` si no se publican: esto no
   * concatena ningún texto ajeno adentro de un atributo, que es la lección de la
   * bandeja de propuestas —un `javascript:…` en un `href` es código—.
   */
  contactos: readonly { texto: string; href: string | null }[];
  tituloDeContactos: string;
  /** Solo si la sección de contactos es la primera después de la descripción. */
  contactosConRegla?: boolean;
  jsonLd: unknown;
  migas: unknown;
}

const {
  nombre,
  descripcion,
  imagenes,
  seccion,
  volver,
  contactos,
  tituloDeContactos,
  contactosConRegla = false,
  jsonLd,
  migas,
} = Astro.props;

const portada = imagenes[0] ?? null;
const resto = imagenes.slice(1);
const publicados = contactos.filter((c): c is Enlace => c.href !== null);
---

<main class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14">
  <p class="label-caps text-azul">
    <a class={claseEnlace} href={RUTA_GUIA}>Guía</a>
    {' · '}
    <a class={claseEnlace} href={seccion.href}>{seccion.texto}</a>
  </p>

  <h1 class="display-md mt-2 text-balance text-acento">{nombre}</h1>

  <slot name="cabecera" />

  {
    portada && (
      <img
        src={portada.url}
        alt={`Foto de ${nombre}`}
        width={portada.ancho ?? undefined}
        height={portada.alto ?? undefined}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        referrerpolicy="no-referrer"
        class={`mt-8 ${claseAfiche}`}
      />
    )
  }

  {portada?.epigrafe && <p class="body-sm mt-2 text-suave">{portada.epigrafe}</p>}

  {descripcion && <p class="body-lectura mt-8 max-w-[65ch] text-super">{descripcion}</p>}

  <slot />

  {
    publicados.length > 0 && (
      <section class={contactosConRegla ? 'regla-gruesa-arriba mt-10 pt-6' : 'mt-10'}>
        <h2 class="headline-sm text-tinta">{tituloDeContactos}</h2>
        <ul class="mt-3 flex flex-col gap-2">
          {publicados.map((c) => (
            <li>
              {/*
                `rel="noopener"` y `target="_blank"`: son destinos de afuera, y el
                `mailto:` no abre pestaña pero tampoco molesta. **Sin
                `noreferrer`**: ninguno de estos es un link de cobro, y aplicarlo
                parejo a todo link externo revertiría B-786 sin decirlo. El único
                `noreferrer` de la Guía es el de la acción de una suscripción.
              */}
              <a class={claseEnlace} href={c.href} rel="noopener" target="_blank">
                {c.texto}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    resto.length > 0 && (
      <section class="mt-10">
        <h2 class="headline-sm text-tinta">Fotos</h2>
        <div class="mt-4 flex flex-col gap-6">
          {resto.map((i) => (
            <figure>
              <img
                src={i.url}
                alt={`Foto de ${nombre}`}
                width={i.ancho ?? undefined}
                height={i.alto ?? undefined}
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
                class={claseAfiche}
              />
              {i.epigrafe && <figcaption class="body-sm mt-2 text-suave">{i.epigrafe}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )
  }

  <p class="body-sm mt-12 text-super">
    <a class={claseEnlace} href={volver.href}>{volver.texto}</a>
  </p>

  {/*
    El `replace` de `<` es la misma guarda que la página de detalle:
    `JSON.stringify` escapa comillas y barras invertidas, **no** un `</script>`
    adentro de un string.
  */}
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(migas).replace(/</g, '\\u003c')}
  />
</main>
