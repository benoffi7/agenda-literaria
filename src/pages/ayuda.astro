---
/**
 * `/ayuda` — B-232, B-253.
 *
 * Le habla a **quien busca una actividad**, no a quien la carga: la guía del
 * panel es otra cosa y vive adentro del panel.
 *
 * ── Por qué está todo abierto y no en un acordeón ─────────────────────────
 * Un acordeón de veinte preguntas se ve ordenado y se usa mal: hay que adivinar
 * en cuál está la respuesta y abrir de a una, el buscador del navegador no
 * encuentra lo que está cerrado en algunos navegadores, y quien llega desde
 * Google a una respuesta puntual aterriza sobre un título plegado. Acá el texto
 * está entero en la página, con un índice arriba para saltar. También es lo que
 * hace que la página sirva para lo que más se usa: mandarle a alguien el link de
 * una respuesta puntual (D-136).
 *
 * **Cada pregunta tiene su ancla y son links que se comparten**: el `id` sale del
 * contenido (`p.id`), nunca de la posición, así que reordenar el archivo de datos
 * no rompe un link que alguien mandó por WhatsApp hace tres meses. Es la trampa
 * 10 con otra cara.
 *
 * El contenido es data (`src/lib/ayudaDelSitio.ts`) y no párrafos acá: es lo que
 * permite testear que no falte una pregunta y que el glosario de tipos no se
 * quede viejo cuando el modelo suma una categoría.
 *
 * ── Lo que B-253 cambió, que es solo cómo se ve ───────────────────────────
 * Veinte preguntas seguidas en una columna de texto son un documento, no una
 * página: sin superficie ni borde, la respuesta larga y la corta pesan lo mismo y
 * no hay dónde apoyar la vista. Ahora cada pregunta es una tarjeta sobre el
 * fondo, cada grupo abre con su regla acentuada, y el índice es una superficie
 * hundida — las tres con los tokens de D-141 y **ninguna sombra**.
 */
import { NOMBRE } from '@/lib/identidad';
import Base from '@/layouts/Base.astro';
import { CIERRE_DE_AYUDA, ENTRADA_DE_AYUDA, GRUPOS_DE_AYUDA } from '@/lib/ayudaDelSitio';
import {
  claseEnlace,
  claseHundido,
  claseRotulo,
  claseTarjeta,
  foco,
} from '@/components/sitio/estilos';
---

<Base
  seccion="ayuda"
  titulo={`Ayuda — ${NOMBRE}`}
  descripcion="Cómo funciona la agenda: qué es cada tipo de actividad, qué quiere decir «a la gorra», cómo anotarse y cómo suscribirse al calendario."
>
  <main class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14">
    <h1 class="font-serif text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
      Ayuda
    </h1>
    <p class="mt-4 max-w-[65ch] text-lg text-tinta/80">{ENTRADA_DE_AYUDA}</p>

    {/*
      El índice, sobre la superficie hundida: es un panel de navegación y no una
      lista de contenido, y hundirlo lo separa de las respuestas sin agregarle
      otra caja al medio.
    */}
    <nav aria-labelledby="indice" class={`mt-8 p-4 sm:p-5 ${claseHundido}`}>
      <h2 id="indice" class={claseRotulo}>En esta página</h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {
          GRUPOS_DE_AYUDA.map((grupo) => (
            <li>
              <a
                class={`flex min-h-touch items-center rounded-md border border-borde bg-papel px-3 text-sm text-tinta transition-colors hover:border-acento hover:text-acento ${foco}`}
                href={`#${grupo.id}`}
              >
                {grupo.titulo}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      GRUPOS_DE_AYUDA.map((grupo) => (
        <section aria-labelledby={grupo.id} class="mt-14">
          <h2
            id={grupo.id}
            class="scroll-mt-6 border-t-2 border-acento/40 pt-4 font-serif text-2xl font-semibold tracking-tight text-acento"
          >
            {grupo.titulo}
          </h2>

          {grupo.preguntas.map((p) => (
            /*
              El `id` va en el `<h3>` y **no se toca**: es el ancla que está en los
              links que ya se mandaron (`/ayuda#...`), sale del contenido y no de
              la posición, así que reordenar el archivo de datos no la rompe. El
              `scroll-mt` es para que al aterrizar el título no quede pegado al
              borde de arriba de la pantalla.
            */
            <article class={`mt-4 p-5 sm:p-6 ${claseTarjeta}`}>
              <h3 id={p.id} class="scroll-mt-6 font-serif text-xl font-semibold text-tinta">
                {p.pregunta}
              </h3>

              {p.respuesta.map((parrafo) => (
                <p class="mt-3 max-w-[65ch] text-tinta/80">{parrafo}</p>
              ))}

              {p.glosario && (
                <dl class="mt-5 border-s-2 border-acento/30 ps-4">
                  {p.glosario.map((termino) => (
                    <div class="mt-4 first:mt-0">
                      <dt class="font-semibold text-tinta">{termino.label}</dt>
                      <dd class="mt-1 max-w-[65ch] text-tinta/80">{termino.que}</dd>
                    </div>
                  ))}
                </dl>
              )}

              {p.enlaces && (
                <ul class="mt-4 flex flex-wrap gap-x-5">
                  {p.enlaces.map((e) => (
                    <li>
                      <a class={`flex min-h-touch items-center ${claseEnlace}`} href={e.href}>
                        {e.texto}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </article>
          ))}
        </section>
      ))
    }

    <aside class={`mt-16 p-5 sm:p-6 ${claseTarjeta}`}>
      <h2 class="font-serif text-xl font-semibold text-tinta">{CIERRE_DE_AYUDA.titulo}</h2>
      <p class="mt-2 max-w-[65ch] text-tinta/80">{CIERRE_DE_AYUDA.texto}</p>
      <p class="mt-3">
        <a class={`flex min-h-touch items-center ${claseEnlace}`} href={CIERRE_DE_AYUDA.enlace.href}>
          {CIERRE_DE_AYUDA.enlace.texto}
        </a>
      </p>
    </aside>
  </main>
</Base>
