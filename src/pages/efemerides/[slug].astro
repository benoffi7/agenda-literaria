---
/**
 * `/efemerides/{slug}/` — B-959: una página por efeméride, SSG e indexable.
 *
 * El slug es inmutable después de publicar (trampa 10): el panel lo congela y
 * la regla de Firestore lo impide. La plantilla recibe la proyección pública y
 * nunca el documento (D-140).
 *
 * Al pie van las otras del mismo mes: el linkeo interno que hace que la página
 * no dependa solo del listado para que un buscador la encuentre.
 */
import Base from '@/layouts/Base.astro';
import { caminosDeEfemeride } from '@/lib/contenidoDelSitio';
import {
  descripcionDeEfemeride,
  fechaDeEfemeride,
  migasDeEfemeride,
  vecinasDelMes,
  type EfemeridePublica,
} from '@/lib/efemeridePublica';
import { NOMBRE } from '@/lib/identidad';
import { MESES } from '@/lib/meses';
import { RUTA_EFEMERIDES, rutaDeEfemeride } from '@/lib/rutasPublicas';
import { claseEnlace, claseRotulo } from '@/components/sitio/estilos';

export const prerender = true;

export const getStaticPaths = () => caminosDeEfemeride();

interface Props {
  efemeride: EfemeridePublica;
  todas: EfemeridePublica[];
}

const { efemeride, todas } = Astro.props as Props;
const vecinas = vecinasDelMes(efemeride, todas);
const migas = migasDeEfemeride(efemeride);
const descripcion = descripcionDeEfemeride(efemeride);
const nombreDelMes = MESES[efemeride.mes - 1] ?? '';
---

<Base
  seccion="efemerides"
  titulo={`${efemeride.titulo} — Efemérides — ${NOMBRE}`}
  descripcion={descripcion}
>
  <main class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14">
    <p class="label-caps text-azul">
      <a class={claseEnlace} href={RUTA_EFEMERIDES}>Efemérides</a>
    </p>
    <h1 class="display-md mt-2 text-balance text-acento">{efemeride.titulo}</h1>
    <p class={`${claseRotulo} mt-4`}>{fechaDeEfemeride(efemeride)}</p>

    {
      efemeride.descripcion && (
        <p class="body-lectura mt-8 max-w-[65ch] text-super">{efemeride.descripcion}</p>
      )
    }

    {
      efemeride.fuente && (
        <p class="body-sm mt-6 text-super">
          Fuente:{' '}
          {efemeride.fuente.url ? (
            <a class={claseEnlace} href={efemeride.fuente.url} rel="noopener" target="_blank">
              {efemeride.fuente.texto || efemeride.fuente.url}
            </a>
          ) : (
            efemeride.fuente.texto
          )}
        </p>
      )
    }

    {
      vecinas.length > 0 && (
        <section class="regla-gruesa-arriba mt-10 pt-6">
          <h2 class="headline-sm text-tinta">Más efemérides de {nombreDelMes}</h2>
          <ul class="mt-3 flex flex-col gap-2">
            {vecinas.map((v) => (
              <li class="min-w-0">
                <span class="label-caps text-azul">{fechaDeEfemeride(v)}</span>
                {' · '}
                <a class={claseEnlace} href={rutaDeEfemeride(v.slug)}>
                  {v.titulo}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p class="body-sm mt-12 text-super">
      <a class={claseEnlace} href={RUTA_EFEMERIDES}>← Todas las efemérides</a>
    </p>

    {/*
      Las migas. El `replace` de `<` es la misma guarda que la página de detalle:
      `JSON.stringify` escapa comillas y barras invertidas, no un `</script>`
      adentro de un string.
    */}
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(migas).replace(/</g, '\\u003c')}
    />
  </main>
</Base>
