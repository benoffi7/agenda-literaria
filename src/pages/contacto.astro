---
/**
 * `/contacto` — B-232, B-253.
 *
 * Sin backend: el sitio es estático y no hay nada que reciba un formulario. Son
 * dos `mailto:` con el asunto ya puesto, y **el asunto es la funcionalidad** —
 * separar una sugerencia de un error en la bandeja sin abrirlos es un pedido
 * explícito del dueño.
 *
 * Los dos destinos salen de `urlDeContacto`, nunca de un `mailto:` escrito acá:
 * la dirección y los asuntos viven en un solo lugar (B-228) y una copia en el
 * marcado es la que se olvida de cambiar cuando la casilla cambie.
 *
 * **Se indexa** (sin `noIndex`). Es tentador esconderla para que un robot no
 * coseche la dirección, pero no serviría: la casilla está en el `mailto:` igual,
 * y quien busca «cómo contactar la agenda literaria» tiene que encontrar esta
 * página. La protección contra el spam es filtrar, no esconderse.
 *
 * ── Lo que B-253 cambió, que es solo cómo se ve ───────────────────────────
 * Los dos motivos son **una decisión**: quien entra elige uno y se va. Con los
 * dos bloques en la misma columna y el mismo peso, esa decisión no se leía como
 * tal. Ahora son dos tarjetas que en pantalla ancha van una al lado de la otra —
 * la comparación que la página pide hacer, hecha de un vistazo— y el botón de
 * cada una es el primario terracota, que es el que el sitio usa en todas partes
 * para «esto es lo que viniste a hacer» (D-141).
 */
import { NOMBRE } from '@/lib/identidad';
import Base from '@/layouts/Base.astro';
import {
  ANTES_DE_ESCRIBIR,
  BLOQUES_DE_CONTACTO,
  INTRO_DE_CONTACTO,
  QUE_PASA_DESPUES,
} from '@/lib/contactoDelSitio';
import {
  claseBotonPrimario,
  claseEnlace,
  claseRotulo,
  claseTarjeta,
} from '@/components/sitio/estilos';
---

<Base
  seccion="contacto"
  titulo={`Contacto — ${NOMBRE}`}
  descripcion="Sugerir una actividad para la agenda o avisar de un dato mal publicado."
>
  <main class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14">
    <h1 class="font-serif text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
      Contacto
    </h1>

    {
      INTRO_DE_CONTACTO.map((parrafo) => (
        <p class="mt-4 max-w-[65ch] text-lg text-tinta/80">{parrafo}</p>
      ))
    }

    <p class="mt-4 max-w-[65ch] text-tinta/80">
      <a class={claseEnlace} href={ANTES_DE_ESCRIBIR.href}>{ANTES_DE_ESCRIBIR.texto}</a>.
    </p>

    {/*
      Dos motivos, dos tarjetas, y de `sm` en adelante una al lado de la otra: es
      una elección entre dos y se lee mejor comparándolas que scrolleando de una a
      la siguiente. `items-start` para que la más corta no se estire a la altura
      de la más larga — dos cajas del mismo alto con distinto contenido se leen
      como un error de layout.
    */}
    <div class="mt-10 grid items-start gap-4 sm:grid-cols-2">
      {
        BLOQUES_DE_CONTACTO.map((bloque) => (
          <section
            aria-labelledby={`motivo-${bloque.motivo}`}
            class={`flex min-w-0 flex-col p-5 sm:p-6 ${claseTarjeta}`}
          >
            <h2 id={`motivo-${bloque.motivo}`} class="font-serif text-2xl font-semibold text-tinta">
              {bloque.etiqueta}
            </h2>
            <p class="mt-2 text-tinta/80">{bloque.ayuda}</p>

            <p class={`mt-5 ${claseRotulo}`}>Qué conviene contarnos</p>
            <ul class="mt-2 list-disc space-y-1 ps-5 text-tinta/80 marker:text-tinta/70">
              {bloque.queIncluir.map((item) => (
                <li class="min-w-0">{item}</li>
              ))}
            </ul>

            <p class="mt-6">
              <a class={`${claseBotonPrimario} w-full sm:w-auto`} href={bloque.href}>
                {bloque.etiqueta}
              </a>
            </p>
            {/* El asunto se muestra para que se entienda por qué viene puesto, y
                para que quien prefiera escribir desde otra casilla lo pueda copiar. */}
            <p class="mt-2 text-sm text-tinta/70">Se manda con el asunto «{bloque.asunto}».</p>
          </section>
        ))
      }
    </div>

    <section aria-labelledby="que-pasa-despues" class="mt-14 border-t-2 border-acento/40 pt-4">
      <h2
        id="que-pasa-despues"
        class="font-serif text-2xl font-semibold tracking-tight text-acento"
      >
        Qué pasa después
      </h2>
      {QUE_PASA_DESPUES.map((parrafo) => <p class="mt-3 max-w-[65ch] text-tinta/80">{parrafo}</p>)}
    </section>
  </main>
</Base>
