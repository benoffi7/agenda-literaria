---
// Listado público. Todavía es un placeholder: el sitio público es el paso 3 del
// orden de implementación (§10), después del panel de admin.
import Base from '@/layouts/Base.astro';
---

<Base
  seccion="agenda"
  titulo="Agenda de actividades literarias"
  descripcion="Talleres de escritura, clubes de lectura, encuentros y presentaciones en Argentina."
>
  <main class="mx-auto max-w-2xl px-4 py-24 text-center">
    <h1 class="font-serif text-3xl font-semibold">Agenda literaria</h1>
    <p class="mt-3 text-tinta/60">
      Talleres, clubes de lectura, encuentros y presentaciones.
    </p>
    <p class="mt-8 text-sm text-tinta/45">
      El sitio público es el paso 3 del orden de implementación. Por ahora, el
      panel de carga vive en <a class="text-acento underline" href="/admin">/admin</a>.
    </p>
  </main>
</Base>
