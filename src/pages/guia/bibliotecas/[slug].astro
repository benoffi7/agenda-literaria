---
/**
 * `/guia/bibliotecas/{slug}` — la ficha de una biblioteca. **B-960**.
 *
 * ── Cero JavaScript, como la página de detalle ────────────────────────────
 * No hay islands: es HTML y CSS del build. Quien cae acá llega de Google o de un
 * link, y tiene tres preguntas —dónde queda, cuándo abre y cómo saco un libro—.
 *
 * ── Esta plantilla no ve el documento (D-140) ─────────────────────────────
 * `getStaticPaths` es `caminosDeDirectorio('bibliotecas')` (`lib/contenidoDeLaGuia.ts`), que
 * entrega **solo** una `FichaDeBiblioteca`: el view-model que
 * `bibliotecaPublica.ts` armó enumerando campo por campo. Acá no hay una
 * `Biblioteca` ni un documento de Firestore, así que **no se puede interpolar el
 * `contactoDeQuienCargo`, ni el motivo del rechazo, ni el `storagePath` de una
 * imagen**: no están en el objeto.
 *
 * Y los contactos llegan **ya como `href`** y ya saneados (`urlSegura`,
 * `handleInstagram`): esta plantilla no concatena ningún texto ajeno adentro de
 * un atributo. Un `javascript:…` en un `href` es código, y Astro escapa el
 * contenido, no el esquema.
 *
 * ── El costo de asociarse se imprime tal como viene ───────────────────────
 * `ficha.asociarse.costo` **ya es la frase con su fecha pegada** («$3.000 por
 * año · cargado el 17 de septiembre de 2026»), armada por `fraseConFecha`. Acá
 * no se concatena nada ni se formatea ninguna fecha: si esta plantilla pudiera
 * imprimir el monto sin la fecha, la regla 1 de `datoConFecha.ts` dependería de
 * que quien la escriba se acuerde. Lo que llega es un string o un string vacío,
 * y con vacío no se muestra el bloque.
 *
 * ── Todas las imágenes, no solo la portada ───────────────────────────────
 * El criterio de B-296. La portada va arriba y las demás abajo, y sin imagen
 * **no hay hueco** — igual que en el detalle de una actividad (§7.6).
 *
 * ── El marcado estructurado es el SEO de esta sección ─────────────────────
 * `Library` (subtipo de `LocalBusiness`) más las migas. Sin `openingHours`
 * —texto libre, B-982— y **sin `Offer`**: un precio comparable en la salida que
 * más lo amplifica deshace la decisión de D-570. Los dos salen de
 * `bibliotecaPublica.ts`, no de esta plantilla.
 *
 * La canónica y el Open Graph los pone `Base.astro`, del mismo `urlAbsoluta` del
 * que sale el `url` del JSON-LD: tres salidas, un solo origen.
 */
import Base from '@/layouts/Base.astro';
import { caminosDeDirectorio } from '@/lib/contenidoDeLaGuia';
import {
  datosEstructuradosDeBiblioteca,
  descripcionDeBiblioteca,
  migasDeBiblioteca,
  type FichaDeBiblioteca,
} from '@/lib/bibliotecaPublica';
import { NOMBRE } from '@/lib/identidad';
import { RUTA_BIBLIOTECAS, RUTA_GUIA } from '@/lib/rutasPublicas';
import { claseAfiche, claseEnlace, claseRotulo } from '@/components/sitio/estilos';

export const prerender = true;

/*
 * Envuelta y no aliaseada: Astro llama a `getStaticPaths` con un argumento
 * propio (`{ paginate, rss }`) y con el alias ese objeto caería en el primer
 * parámetro. Es la lección de B-237.
 */
export const getStaticPaths = () => caminosDeDirectorio('bibliotecas');

interface Props {
  ficha: FichaDeBiblioteca;
}

const { ficha } = Astro.props as Props;

const jsonLd = datosEstructuradosDeBiblioteca(ficha);
const migas = migasDeBiblioteca(ficha);

const portada = ficha.imagenes[0] ?? null;
const resto = ficha.imagenes.slice(1);

/*
 * La frase sale del módulo puro y **no se arma acá** — el criterio que el
 * `auditor-privacidad` fijó para `descripcionDeLibreria`: una `meta description`
 * interpolada dentro de un `.astro` es un productor de texto público que vitest
 * no puede importar, o sea que no se puede barrer.
 */
const descripcion = descripcionDeBiblioteca(ficha);

/**
 * Los contactos, en el orden en que sirven: primero el que abre una
 * conversación, después el que abre una página.
 *
 * **El catálogo va primero de los «de página»** y no mezclado con el sitio web:
 * es el que contesta la pregunta por la que alguien entró a una biblioteca y no
 * a una librería.
 *
 * Se arma acá y no en el view-model porque es **presentación** —cómo se llama
 * cada canal y en qué orden se listan—; el módulo puro decide cuáles se publican
 * y a dónde llevan.
 */
const contactos = [
  { texto: 'WhatsApp', href: ficha.enlaces.whatsapp },
  { texto: 'Instagram', href: ficha.enlaces.instagram },
  { texto: 'Catálogo online', href: ficha.enlaces.catalogo },
  { texto: 'Sitio web', href: ficha.enlaces.web },
  { texto: 'Mail', href: ficha.enlaces.mail },
].filter((c): c is { texto: string; href: string } => c.href !== null);
---

<Base
  seccion="guia"
  titulo={`${ficha.nombre} — Bibliotecas — ${NOMBRE}`}
  descripcion={descripcion}
  imagen={portada?.url ?? null}
>
  <main class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14">
    <p class="label-caps text-azul">
      <a class={claseEnlace} href={RUTA_GUIA}>Guía</a>
      {' · '}
      <a class={claseEnlace} href={RUTA_BIBLIOTECAS}>Bibliotecas</a>
    </p>

    <h1 class="display-md mt-2 text-balance text-acento">{ficha.nombre}</h1>

    {/*
      El renglón sale de `ficha.zona`, que trae la regla de CABA aplicada
      (adentro, el barrio; afuera, la ciudad y la provincia) y el enlace de cada
      pieza ya resuelto. Es la misma forma que el «Dónde» de una actividad.

      El tipo va al final y sin enlace: no hay hub de tipo de biblioteca.
    */}
    <p class={`${claseRotulo} mt-4`}>
      {ficha.zona.map((pieza, i) => (
        <>
          {i > 0 && ' · '}
          {pieza.href ? (
            <a class={claseEnlace} href={pieza.href}>{pieza.texto}</a>
          ) : (
            pieza.texto
          )}
        </>
      ))}
      {ficha.tipo && ` · ${ficha.tipo}`}
    </p>

    <p class="body-md mt-1 text-super">{ficha.direccion}</p>

    {/*
      Los dos horarios, si se cargaron. Pegados a la dirección porque contestan
      la misma pregunta: «¿voy o no voy ahora?». Y son dos renglones y no uno
      porque en una biblioteca no son lo mismo — el mostrador puede abrir de 9 a
      20 y la sala de 14 a 19.

      **No entran al JSON-LD**: `schema.org/openingHours` quiere un formato fijo
      y esto es texto libre, así que emitirlo sería publicar un horario que
      Google puede mostrar mal al costado del resultado (B-982).
    */}
    {ficha.horarios && <p class="body-sm mt-1 text-super">{ficha.horarios}</p>}
    {ficha.horarioDeSala && (
      <p class="body-sm mt-1 text-super">Sala de lectura: {ficha.horarioDeSala}</p>
    )}

    {
      portada && (
        <img
          src={portada.url}
          alt={`Foto de ${ficha.nombre}`}
          width={portada.ancho ?? undefined}
          height={portada.alto ?? undefined}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          referrerpolicy="no-referrer"
          class={`mt-8 ${claseAfiche}`}
        />
      )
    }

    {portada?.epigrafe && <p class="body-sm mt-2 text-suave">{portada.epigrafe}</p>}

    {ficha.descripcion && (
      <p class="body-lectura mt-8 max-w-[65ch] text-super">{ficha.descripcion}</p>
    )}

    {/*
      **Cómo se saca un libro** — la sección que esta ficha tiene y ninguna otra
      del sitio.

      El costo se imprime tal como viene del view-model: es la frase con su fecha
      pegada, y acá no se la desarma. Cuando la biblioteca no cargó el costo —o
      cuando su fecha no era usable— llega vacío y solo queda la línea de que hay
      que asociarse, que es la respuesta útil igual.
    */}
    <section class="regla-gruesa-arriba mt-10 pt-6">
      <h2 class="headline-sm text-tinta">Para llevarse libros</h2>
      <p class="body-md mt-3 max-w-[65ch] text-super">
        {ficha.asociarse.haceFalta ? 'Hay que asociarse.' : 'No hace falta asociarse.'}
      </p>
      {ficha.asociarse.costo && (
        <p class="body-sm mt-1 text-suave">{ficha.asociarse.costo}</p>
      )}
    </section>

    {
      contactos.length > 0 && (
        <section class="mt-10">
          <h2 class="headline-sm text-tinta">Cómo contactarla</h2>
          <ul class="mt-3 flex flex-col gap-2">
            {contactos.map((c) => (
              <li>
                {/*
                  `rel="noopener"` y `target="_blank"`: son destinos de afuera, y
                  el `mailto:` no abre pestaña pero tampoco molesta. El `href` ya
                  vino saneado del view-model.
                */}
                <a class={claseEnlace} href={c.href} rel="noopener" target="_blank">
                  {c.texto}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      /*
        El resto de la galería — B-296: **todas** las imágenes, no solo la
        portada. Van al final del contenido, como en el detalle de una actividad.
      */
      resto.length > 0 && (
        <section class="mt-10">
          <h2 class="headline-sm text-tinta">Fotos</h2>
          <div class="mt-4 flex flex-col gap-6">
            {resto.map((i) => (
              <figure>
                <img
                  src={i.url}
                  alt={`Foto de ${ficha.nombre}`}
                  width={i.ancho ?? undefined}
                  height={i.alto ?? undefined}
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                  class={claseAfiche}
                />
                {i.epigrafe && (
                  <figcaption class="body-sm mt-2 text-suave">{i.epigrafe}</figcaption>
                )}
              </figure>
            ))}
          </div>
        </section>
      )
    }

    <p class="body-sm mt-12 text-super">
      <a class={claseEnlace} href={RUTA_BIBLIOTECAS}>← Todas las bibliotecas</a>
    </p>

    {/*
      `Library` y las migas. El `replace` de `<` es la misma guarda que la página
      de detalle: `JSON.stringify` escapa comillas y barras invertidas, **no** un
      `</script>` adentro de un string.
    */}
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(migas).replace(/</g, '\\u003c')}
    />
  </main>
</Base>
