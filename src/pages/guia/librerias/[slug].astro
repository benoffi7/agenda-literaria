---
/**
 * `/guia/librerias/{slug}` — la ficha de una librería. B-831, §4 del PRD 2.
 *
 * ── Cero JavaScript, como la página de detalle ────────────────────────────
 * No hay islands: es HTML y CSS del build. Quien cae acá llega de Google o de un
 * link, y tiene una sola pregunta —dónde queda y cómo le escribo—.
 *
 * ── Esta plantilla no ve el documento (D-140) ─────────────────────────────
 * `getStaticPaths` es `caminosDeLibreria` (`lib/contenidoDelSitio.ts`), que
 * entrega **solo** una `FichaDeLibreria`: el view-model que `libreriaPublica.ts`
 * armó enumerando campo por campo. Acá no hay una `Libreria` ni un documento de
 * Firestore, así que **no se puede interpolar el `contactoDeQuienCargo`, ni el
 * motivo del rechazo, ni el `storagePath` de una imagen**: no están en el objeto.
 *
 * Y los cuatro contactos llegan **ya como `href`** y ya saneados (`urlSegura`,
 * `handleInstagram`): esta plantilla no concatena ningún texto ajeno adentro de
 * un atributo. Es la lección de la bandeja de propuestas — un `javascript:…` en
 * un `href` es código, y React (o Astro) escapa el contenido, no el esquema.
 *
 * ── Todas las imágenes, no solo la portada ───────────────────────────────
 * El criterio de B-296, que el § 4 del PRD nombra: la galería entera. La portada
 * va arriba y las demás abajo, y sin imagen **no hay hueco** — igual que en el
 * detalle de una actividad (§7.6).
 *
 * ── El marcado estructurado es el SEO de esta sección ─────────────────────
 * `BookStore` (subtipo de `LocalBusiness`) más las migas. Sin `openingHours`,
 * porque no se piden horarios (§ 7 del PRD) y un horario inventado es peor que
 * ninguno. Los dos salen de `libreriaPublica.ts`, no de esta plantilla.
 *
 * La canónica y el Open Graph los pone `Base.astro`, del mismo `urlAbsoluta` del
 * que sale el `url` del JSON-LD: tres salidas, un solo origen.
 */
import Base from '@/layouts/Base.astro';
import { caminosDeLibreria } from '@/lib/contenidoDelSitio';
import {
  datosEstructuradosDeLibreria,
  descripcionDeLibreria,
  migasDeLibreria,
  type FichaDeLibreria,
} from '@/lib/libreriaPublica';
import { NOMBRE } from '@/lib/identidad';
import { RUTA_GUIA, RUTA_LIBRERIAS } from '@/lib/rutasPublicas';
import { claseAfiche, claseEnlace, claseRotulo } from '@/components/sitio/estilos';

export const prerender = true;

/*
 * Envuelta y no aliaseada: Astro llama a `getStaticPaths` con un argumento propio
 * (`{ paginate, rss }`) y con el alias ese objeto caería en el primer parámetro.
 * Es la lección de B-237, y vale aunque hoy esta función no reciba ninguno.
 */
export const getStaticPaths = () => caminosDeLibreria();

interface Props {
  ficha: FichaDeLibreria;
}

const { ficha } = Astro.props as Props;

const jsonLd = datosEstructuradosDeLibreria(ficha);
const migas = migasDeLibreria(ficha);

const portada = ficha.imagenes[0] ?? null;
const resto = ficha.imagenes.slice(1);

/*
 * La frase sale del módulo puro y **no se arma acá** — lo pidió el
 * `auditor-privacidad`. Una `meta description` interpolada dentro de un `.astro`
 * es un productor de texto público que vitest no puede importar, o sea que no se
 * puede barrer: es la superficie de `descripcionDelMes` (salida 8). Acá la
 * plantilla vuelve a «solo acomodar» (D-140).
 */
const descripcion = descripcionDeLibreria(ficha);

/**
 * Los cuatro contactos, en el orden en que sirven: primero el que abre una
 * conversación, después el que abre una página.
 *
 * Se arma acá y no en el view-model porque es **presentación** —cómo se llama
 * cada canal y en qué orden se listan—; el módulo puro decide cuáles se publican
 * y a dónde llevan.
 */
const contactos = [
  { texto: 'WhatsApp', href: ficha.enlaces.whatsapp },
  { texto: 'Instagram', href: ficha.enlaces.instagram },
  { texto: 'Sitio web', href: ficha.enlaces.web },
  { texto: 'Mail', href: ficha.enlaces.mail },
].filter((c): c is { texto: string; href: string } => c.href !== null);
---

<Base
  seccion="guia"
  titulo={`${ficha.nombre} — Librerías — ${NOMBRE}`}
  descripcion={descripcion}
  imagen={portada?.url ?? null}
>
  <main class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14">
    <p class="label-caps text-azul">
      <a class={claseEnlace} href={RUTA_GUIA}>Guía</a>
      {' · '}
      <a class={claseEnlace} href={RUTA_LIBRERIAS}>Librerías</a>
    </p>

    <h1 class="display-md mt-2 text-balance text-acento">{ficha.nombre}</h1>

    <p class={`${claseRotulo} mt-4`}>
      {
        ficha.rutaDelBarrio ? (
          <a class={claseEnlace} href={ficha.rutaDelBarrio}>
            {ficha.barrio}
          </a>
        ) : (
          ficha.barrio
        )
      }
      {ficha.ciudad ? ` · ${ficha.ciudad}` : ''}
    </p>

    <p class="body-md mt-1 text-super">{ficha.direccion}</p>

    {
      portada && (
        <img
          src={portada.url}
          alt={`Foto de ${ficha.nombre}`}
          width={portada.ancho ?? undefined}
          height={portada.alto ?? undefined}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          referrerpolicy="no-referrer"
          class={`mt-8 ${claseAfiche}`}
        />
      )
    }

    {portada?.epigrafe && <p class="body-sm mt-2 text-suave">{portada.epigrafe}</p>}

    {ficha.descripcion && (
      <p class="body-lectura mt-8 max-w-[65ch] text-super">{ficha.descripcion}</p>
    )}

    {
      contactos.length > 0 && (
        <section class="regla-gruesa-arriba mt-10 pt-6">
          <h2 class="headline-sm text-tinta">Cómo contactarla</h2>
          <ul class="mt-3 flex flex-col gap-2">
            {contactos.map((c) => (
              <li>
                {/*
                  `rel="noopener"` y `target="_blank"` en los cuatro: son destinos
                  de afuera, y el `mailto:` no abre pestaña pero tampoco molesta.
                  El `href` ya vino saneado del view-model.
                */}
                <a class={claseEnlace} href={c.href} rel="noopener" target="_blank">
                  {c.texto}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      /*
        El resto de la galería — B-296: **todas** las imágenes, no solo la
        portada. Van al final del contenido, como en el detalle de una actividad.
      */
      resto.length > 0 && (
        <section class="mt-10">
          <h2 class="headline-sm text-tinta">Fotos</h2>
          <div class="mt-4 flex flex-col gap-6">
            {resto.map((i) => (
              <figure>
                <img
                  src={i.url}
                  alt={`Foto de ${ficha.nombre}`}
                  width={i.ancho ?? undefined}
                  height={i.alto ?? undefined}
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                  class={claseAfiche}
                />
                {i.epigrafe && (
                  <figcaption class="body-sm mt-2 text-suave">{i.epigrafe}</figcaption>
                )}
              </figure>
            ))}
          </div>
        </section>
      )
    }

    <p class="body-sm mt-12 text-super">
      <a class={claseEnlace} href={RUTA_LIBRERIAS}>← Todas las librerías</a>
    </p>

    {/*
      `BookStore` y las migas. El `replace` de `<` es la misma guarda que la página
      de detalle: `JSON.stringify` escapa comillas y barras invertidas, **no** un
      `</script>` adentro de un string.
    */}
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(migas).replace(/</g, '\\u003c')}
    />
  </main>
</Base>
