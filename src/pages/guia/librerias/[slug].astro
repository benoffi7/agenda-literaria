---
/**
 * `/guia/librerias/{slug}` — la ficha de una librería. B-831, §4 del PRD 2.
 *
 * ── Cero JavaScript, como la página de detalle ────────────────────────────
 * No hay islands: es HTML y CSS del build. Quien cae acá llega de Google o de un
 * link, y tiene una sola pregunta —dónde queda y cómo le escribo—.
 *
 * ── Esta plantilla no ve el documento (D-140) ─────────────────────────────
 * `getStaticPaths` es `caminosDeDirectorio('librerias')` (`lib/contenidoDeLaGuia.ts`), que
 * entrega **solo** una `FichaDeLibreria`: el view-model que `libreriaPublica.ts`
 * armó enumerando campo por campo. Acá no hay una `Libreria` ni un documento de
 * Firestore, así que **no se puede interpolar el `contactoDeQuienCargo`, ni el
 * motivo del rechazo, ni el `storagePath` de una imagen**: no están en el objeto.
 *
 * Y los cuatro contactos llegan **ya como `href`** y ya saneados (`urlSegura`,
 * `handleInstagram`): esta plantilla no concatena ningún texto ajeno adentro de
 * un atributo. Es la lección de la bandeja de propuestas — un `javascript:…` en
 * un `href` es código, y React (o Astro) escapa el contenido, no el esquema.
 *
 * ── El esqueleto es `FichaDeGuia.astro` (M-10) ───────────────────────────
 * Las migas, la portada, la galería entera (B-296), los contactos y los dos
 * bloques de JSON-LD los pinta el componente; esta página le pasa lo suyo.
 *
 * ── El marcado estructurado es el SEO de esta sección ─────────────────────
 * `BookStore` (subtipo de `LocalBusiness`) más las migas. Sin `openingHours`,
 * porque no se piden horarios (§ 7 del PRD) y un horario inventado es peor que
 * ninguno. Los dos salen de `libreriaPublica.ts`, no de esta plantilla.
 *
 * La canónica y el Open Graph los pone `Base.astro`, del mismo `urlAbsoluta` del
 * que sale el `url` del JSON-LD: tres salidas, un solo origen.
 */
import Base from '@/layouts/Base.astro';
import FichaDeGuia from '@/components/sitio/FichaDeGuia.astro';
import { caminosDeDirectorio } from '@/lib/contenidoDeLaGuia';
import {
  datosEstructuradosDeLibreria,
  descripcionDeLibreria,
  migasDeLibreria,
  type FichaDeLibreria,
} from '@/lib/libreriaPublica';
import { NOMBRE } from '@/lib/identidad';
import { RUTA_LIBRERIAS } from '@/lib/rutasPublicas';
import { claseEnlace, claseRotulo } from '@/components/sitio/estilos';

export const prerender = true;

/*
 * Envuelta y no aliaseada: Astro llama a `getStaticPaths` con un argumento propio
 * (`{ paginate, rss }`) y con el alias ese objeto caería en el primer parámetro.
 * Es la lección de B-237, y vale aunque hoy esta función no reciba ninguno.
 */
export const getStaticPaths = () => caminosDeDirectorio('librerias');

interface Props {
  ficha: FichaDeLibreria;
}

const { ficha } = Astro.props as Props;

/*
 * La frase sale del módulo puro y **no se arma acá** — lo pidió el
 * `auditor-privacidad`. Una `meta description` interpolada dentro de un `.astro`
 * es un productor de texto público que vitest no puede importar, o sea que no se
 * puede barrer: es la superficie de `descripcionDelMes` (salida 8). Acá la
 * plantilla vuelve a «solo acomodar» (D-140).
 */
const descripcion = descripcionDeLibreria(ficha);

/**
 * Los cuatro contactos, en el orden en que sirven: primero el que abre una
 * conversación, después el que abre una página.
 *
 * Se arma acá y no en el view-model porque es **presentación** —cómo se llama
 * cada canal y en qué orden se listan—; el módulo puro decide cuáles se publican
 * y a dónde llevan.
 */
const contactos = [
  { texto: 'WhatsApp', href: ficha.enlaces.whatsapp },
  { texto: 'Instagram', href: ficha.enlaces.instagram },
  { texto: 'Sitio web', href: ficha.enlaces.web },
  { texto: 'Mail', href: ficha.enlaces.mail },
];
---

<Base
  seccion="guia"
  titulo={`${ficha.nombre} — Librerías — ${NOMBRE}`}
  descripcion={descripcion}
  imagen={ficha.imagenes[0]?.url ?? null}
>
  <FichaDeGuia
    nombre={ficha.nombre}
    descripcion={ficha.descripcion}
    imagenes={ficha.imagenes}
    seccion={{ texto: 'Librerías', href: RUTA_LIBRERIAS }}
    volver={{ texto: '← Todas las librerías', href: RUTA_LIBRERIAS }}
    contactos={contactos}
    tituloDeContactos="Cómo contactarla"
    contactosConRegla
    jsonLd={datosEstructuradosDeLibreria(ficha)}
    migas={migasDeLibreria(ficha)}
  >
    <Fragment slot="cabecera">
      {/*
        B-967 — el renglón sale de `ficha.zona`, que trae la regla de CABA aplicada
        (adentro, el barrio; afuera, la ciudad y la provincia) y el enlace de cada
        pieza ya resuelto. Es la misma forma que el «Dónde» de una actividad.
      */}
      <p class={`${claseRotulo} mt-4`}>
        {ficha.zona.map((pieza, i) => (
          <>
            {i > 0 && ' · '}
            {pieza.href ? (
              <a class={claseEnlace} href={pieza.href}>{pieza.texto}</a>
            ) : (
              pieza.texto
            )}
          </>
        ))}
      </p>

      <p class="body-md mt-1 text-super">{ficha.direccion}</p>

      {/*
        B-982 — el horario, si se cargó. Pegado a la dirección porque contestan la
        misma pregunta: «¿voy o no voy ahora?». Un directorio que dice dónde queda y
        no cuándo abre manda a la gente a la puerta cerrada.

        **No entra al JSON-LD**: `schema.org/openingHours` quiere un formato fijo
        (`Mo-Fr 10:00-20:00`) y esto es texto libre, así que emitirlo sería
        publicar un horario que Google puede mostrar mal al costado del resultado.
        Ver `TOPE_HORARIOS_LIBRERIA`.
      */}
      {ficha.horarios && <p class="body-sm mt-1 text-super">{ficha.horarios}</p>}
    </Fragment>
  </FichaDeGuia>
</Base>
