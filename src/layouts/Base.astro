---
import '@/styles/global.css';
import Encabezado, { type Seccion } from '@/components/sitio/Encabezado.astro';
import PieDePagina from '@/components/sitio/PieDePagina.astro';
import AvisoDeCookies from '@/components/sitio/AvisoDeCookies.astro';
import { NOMBRE } from '@/lib/identidad';
import { urlAbsoluta } from '@/lib/rutasPublicas';

interface Props {
  titulo: string;
  descripcion?: string;
  noIndex?: boolean;
  /**
   * La imagen para el preview de un link compartido (`og:image`) — B-109.
   *
   * **Real, o la marca.** Hoy solo la pasa la página de detalle, con la portada
   * de la actividad: un flyer es literalmente la imagen de esa actividad y es la
   * que hace que el link pegado en Instagram o en WhatsApp se vea. Las cinco
   * imágenes estáticas por tipo que pide el §5.1 del diseño —para las actividades
   * sin flyer— siguen sin existir: son **B-291**.
   *
   * **Desde B-295 hay respaldo**: si nadie pasa imagen, va la marca
   * (`/compartir.png`). Se cambió el criterio de B-109 —que prefería un preview
   * sin imagen a un `og:image` roto— porque **cambió el hecho**: antes no había
   * ninguna imagen que ofrecer, ahora hay una, cuadrada, de 13 KB y con los
   * tokens del sitio. Un link compartido sin imagen se ve como un link pelado, y
   * eso también es una decisión que nadie tomó.
   *
   * **Puede venir relativa**, y por eso no se emite tal cual: B-291 va a llegar
   * justamente con una ruta local (`/og/taller.png`). Lo señaló el
   * `auditor-privacidad`: el docblock decía «absoluta o nada» y nada lo
   * verificaba.
   */
  imagen?: string | null;
  /**
   * Qué sección del sitio marcar como activa. **`'ninguna'` apaga el encabezado
   * y el pie enteros**, que es lo que necesita `/admin`: el panel es una SPA con
   * su propia navegación y meterle la del sitio público sería dos barras
   * compitiendo por el mismo lugar.
   */
  seccion?: Seccion | 'ninguna';
}

const { titulo, descripcion, noIndex = false, seccion = 'ninguna', imagen = null } = Astro.props;

/*
 * ── La canónica, y por qué se arma acá una sola vez — B-109 ───────────────
 *
 * Sale de `Astro.url.pathname` y no de una prop por página: con una prop, la
 * página que se olvide de pasarla se publica sin canónica y nada falla — y con
 * seis páginas más los hubs de B-108 en camino, eso pasa. El path lo sabe Astro,
 * el origen lo sabe `SITIO` (`lib/rutasPublicas.ts`), y `urlAbsoluta` es la que
 * los junta: **ninguna salida del sitio escribe el dominio a mano**.
 *
 * Y sale del `pathname`, no de `Astro.url.href`: el `href` lleva el origen del
 * servidor que esté corriendo, que en el dev server es `localhost:4321`. Lo que
 * tiene que quedar en el HTML es el origen canónico, siempre el mismo, sin
 * depender de dónde se construyó.
 *
 * **Absoluta y no relativa**, que es la mitad que importa: `agenda-literaria.web.app`
 * y `agendaleh.com.ar` sirven este mismo HTML —el primero para siempre, porque
 * Firebase no lo apaga— y una canónica relativa se resuelve contra el host que la
 * sirvió, o sea que en el espejo diría que la página buena es la del espejo. El
 * canonical absoluto es lo único que corta el contenido duplicado.
 *
 * `urlAbsoluta` agrega la barra final cuando corresponde: es la forma que
 * contesta 200 en Firebase (ver su docblock). La canónica no puede apuntar a una
 * redirección.
 */
const canonical = urlAbsoluta(Astro.url.pathname);

/*
 * El `og:image`: la que pase la página, y si no, la marca — B-295 sobre B-109.
 *
 * **Siempre absoluto**, y el orden importa. Una URL **externa** —el flyer de una
 * actividad, que vive en Storage o en el servidor de quien organiza— se emite tal
 * cual. Una ruta **del sitio** se completa con el mismo origen que la canónica,
 * porque un `og:image` relativo lo ignoran los scrapers en silencio: no hay
 * preview y no hay error. Lo señaló el `auditor-privacidad`.
 *
 * El respaldo va **adentro** de esa absolutización y no al lado: `/compartir.png`
 * es una ruta del sitio y necesita el mismo tratamiento que cualquier otra.
 *
 * Con `??` y no con `||`: una cadena vacía es un dato mal cargado y tiene que
 * caer al respaldo igual que un `null`.
 *
 * ── Y las dos barras se escriben `\/{2}` y no `\/\/` — B-876 ────────────────
 * La forma natural del predicado era `/^https?:\/\//i`, y ese `\/\/` **contiene
 * el par `//` literal**. `scripts/sin-comentarios.mjs` —el saneador que usan los
 * tests sobre fuente— no lexea literales de expresión regular (lo dice su propio
 * docblock: distinguir `/…/` de una división necesita el token anterior, o sea
 * medio parser de JS, que además no serviría para `firestore.rules`), así que
 * leía ese `//` como comentario de línea y **se comía el resto de la línea**: el
 * archivo volvía cortado en `const ogImagen = /^https?:\/\` y sin el ternario.
 *
 * `\/{2}` es el mismo lenguaje —una barra escapada, repetida dos veces— y no
 * tiene el par. Cuesta una línea y es lo que deja que el control de clase de
 * `tests/sin-comentarios.test.ts` se extienda al frontmatter de los `.astro`,
 * que es la red que faltaba: si alguien vuelve a escribir `\/\/` acá, ese test
 * se pone rojo. **No revertir a `\/\/` sin leer B-876.**
 */
const paraOg = imagen ?? '/compartir.png';
const ogImagen = /^https?:\/{2}/i.test(paraOg) ? paraOg : urlAbsoluta(paraOg);

/*
 * El `<body>` lleva `overflow-x-clip` y no `-hidden` — B-259. Los dos recortan
 * igual, pero `hidden` **crea un contenedor de scroll** y eso rompe
 * `position: sticky` adentro, en silencio: el elemento simplemente nunca se pega,
 * sin error ni advertencia. `clip` no crea el contenedor, así que `sticky` sigue
 * disponible para quien lo necesite.
 *
 * **Esta nota vive acá y no al lado del `<body>` — B-261.** Un `{/* … *\/}` puesto
 * entre `</head>` y `<body>` **no lo elimina Astro**: se emite como texto crudo, y
 * este párrafo estuvo publicado dentro de la home. Los comentarios de plantilla
 * solo se eliminan donde Astro parsea una expresión; en el frontmatter, que es
 * código, nunca se emiten.
 */
const conChrome = seccion !== 'ninguna';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover: deja que la página pinte detrás del notch y de la
         barra de gestos del iPhone. Lo que no puede quedar tapado se separa
         con env(safe-area-inset-*) desde el CSS. -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    {/* El papel del sistema (`#fbf9f4`), el mismo que `--color-papel`. */}
    <meta name="theme-color" content="#fbf9f4" />
    <title>{titulo}</title>
    {descripcion && <meta name="description" content={descripcion} />}
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    {/*
      §5.1 del diseño — la canónica y el Open Graph, **en todas las páginas**
      (B-109). Faltaban a propósito hasta que el dominio existiera: una canónica
      a un dominio equivocado le dice a Google que la página buena es otra, que
      es peor que no tener canónica.

      Van acá y no en cada página por lo mismo que el chrome (B-229): olvidarse
      no rompe nada visible. Una página sin `og:` se comparte en Instagram como
      un link pelado, y eso se descubre compartiéndolo.

      **También en las `noindex`** —el panel y la página de un mes vencido—: el
      `noindex` decide si se indexa y el Open Graph decide cómo se ve el link
      cuando alguien lo pega en un chat. Son dos preguntas distintas, y una
      página que no queremos en Google igual se comparte por WhatsApp.
    */}
    {/*
      El favicon — B-295, rehecho el 2026-09-07 con el logo del proyecto.

      Antes era `marca.svg`: nueve rectángulos, 2,6 KB, nítidos a cualquier
      tamaño. Se retira porque **era una marca de relleno** —hecha para tener
      algo mientras no hubiera logo— y tener dos marcas distintas según el tamaño
      del icono es peor que perder nitidez en una.

      El logo es un trébol de tres libros abiertos, en el terracota y la tinta del
      sistema. Es un raster (no hay versión vectorial), así que van tres tamaños en
      vez de un SVG:

      · **32px** para la pestaña. Es el precio de este cambio y conviene tenerlo
        escrito: a ese tamaño los contornos finos se juntan y la marca se lee como
        una forma, no como tres libros. El SVG viejo era más legible ahí y menos
        parecido a la marca.
      · **180px** para el icono de pantalla de inicio de iOS.
      · **512px** para Android y para cualquier consumidor que quiera el grande.

      Se fue el `mask-icon` (el pinned tab de Safari, monocromo por diseño): pedía
      un SVG y el logo no lo tiene. Safari cae al de 32, que es lo correcto.

      **`compartir.png` sigue siendo el `og:image`** y no se toca: el logo es
      cuadrado y con fondo transparente, o sea justo lo que no funciona en la
      previsualización de un chat.

      No hay `.ico`: solo lo pide IE y buscarlo en la raíz da un 404 silencioso
      que a nadie molesta.
    */}
    <link rel="icon" type="image/png" sizes="32x32" href="/marca-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/marca-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/marca-180.png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={NOMBRE} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={titulo} />
    <meta property="og:url" content={canonical} />
    {descripcion && <meta property="og:description" content={descripcion} />}
    <meta property="og:image" content={ogImagen} />
    {/*
      `summary_large_image` **solo si hay imagen**: la tarjeta grande sin imagen
      se dibuja como un rectángulo vacío con el título abajo, que se ve peor que
      la chica. Es la misma regla del §7.6 con el hueco de la portada — no hay
      placeholder.
    */}
    <meta name="twitter:card" content="summary_large_image" />
    {/*
      ── Las tipografías, y por qué acá no hay ni un host de Google — B-481 ──

      Hasta el 2026-09-03 acá vivían dos `<link rel="preconnect">` y un
      `<link rel="stylesheet">` a `fonts.googleapis.com`, o sea **una conexión a
      un tercero en el load de toda página pública**. Es la misma clase de
      conexión que **D-254** sacó para `googletagmanager.com`, solo que decidida
      en B-260, antes de que existiera el banner de consentimiento: pasaba antes
      de que la persona decidiera y también para quien rechaza.

      Ahora las tres familias salen de `/fuentes/`, este mismo dominio: las
      `@font-face` están en `src/styles/global.css` (con los pesos, los ejes, los
      `unicode-range` y los números del antes/después), y el `Cache-Control` de
      un año va en `firebase.json` bajo `/fuentes/**`.

      **Los tres `preload` no son decoración.** Antes el navegador descubría los
      `.woff2` leyendo la hoja de Google, que era un `<link>` del `<head>` y por
      lo tanto se pedía temprano. Ahora los descubre leyendo el CSS del sitio, un
      paso más adentro de la cadena: sin el `preload`, el pedido de la fuente sale
      después de que ese CSS llegó y se parseó, y con `font-display: swap` eso se
      ve como un cambio de letra más tardío. Se precargan los **tres `latin`** y
      ninguno más: son las tres familias que toda página pinta arriba del pliegue
      (la marca en Fraunces, la navegación en Archivo Narrow, el cuerpo en Public
      Sans), mientras que `latin-ext` **no se precarga a propósito** — el
      navegador lo pide solo si la página tiene una letra de ese rango, y
      precargarlo sería bajar 52 KB que casi ninguna página usa.

      `crossorigin` va **aunque sea el mismo origen**: el navegador pide las
      fuentes en modo CORS anónimo, y un `preload` sin ese atributo se descarga
      igual pero **no se reusa** — dos veces el mismo archivo, que es el modo de
      falla clásico de esta etiqueta.

      **Y van con `conChrome`, igual que el banner**: `/admin` pinta su propia UI
      con `font-serif` (Georgia, cero bytes) y `font-sans`, no usa la display ni
      la de títulos, así que precargarle las tres sería bajarle 36 KB que no
      dibuja. Las `@font-face` siguen valiendo ahí — el panel toma Public Sans
      cuando el CSS llega, un instante más tarde, que en una herramienta interna
      que usan dos personas no cambia nada.
    */}
    {
      conChrome && (
        <Fragment>
          <link
            rel="preload"
            href="/fuentes/public-sans-v21-latin.woff2"
            as="font"
            type="font/woff2"
            crossorigin
          />
          <link
            rel="preload"
            href="/fuentes/archivo-narrow-v35-latin.woff2"
            as="font"
            type="font/woff2"
            crossorigin
          />
          <link
            rel="preload"
            href="/fuentes/fraunces-v38-opsz72-latin.woff2"
            as="font"
            type="font/woff2"
            crossorigin
          />
        </Fragment>
      )
    }
  </head>
  <body class="flex min-h-dvh flex-col overflow-x-clip font-sans antialiased">
    {conChrome && <Encabezado activa={seccion as Seccion} />}
    {/* `flex-1` empuja el pie al fondo cuando la página es más corta que la
        pantalla — un listado filtrado a cero resultados es el caso normal. */}
    <div id="contenido" class="flex-1">
      <slot />
    </div>
    {conChrome && <PieDePagina />}
    {/*
      El banner de cookies — B-372/B-376 (D-250 a D-252 en `06-decisiones.md`).

      **Va con la misma condición que el resto del chrome del sitio**, y no una
      prop nueva: `conChrome` es exactamente «esto es una página del sitio
      público, no `/admin`» (arriba define si se pinta `Encabezado`), y esa es
      la condición que la regla de proceso pide para el banner —«nunca en
      `/admin`: el panel ya mide, con su propia proyección»—. `/admin` pasa
      `seccion` sin definir, que cae a `'ninguna'`, así que `conChrome` es
      `false` ahí y el banner ni se pinta ni carga `gtag.js`.

      **Y a propósito no hay un `<link rel="preconnect">` a
      `googletagmanager.com` acá ni en ningún lado** (D-254). Hubo uno, sin
      condición de consentimiento, y el coordinador lo encontró leyendo
      `dist/index.html` antes de pushear: un `preconnect` no es una pista pasiva — el navegador
      resuelve DNS, abre TCP y completa el handshake TLS con SNI **en el
      load**, y eso le dice al borde de Google que este navegador entró al
      sitio, antes de que la persona toque el banner y también para quien
      **rechaza**. Y en un sitio estático no hay forma de condicionarlo: el
      HTML es el mismo para todos, la decisión vive en el `localStorage` de
      cada visitante. `tests/terceros-antes-del-consentimiento.test.ts` falla
      si vuelve a aparecer.
    */}
    {conChrome && <AvisoDeCookies />}
  </body>
</html>
