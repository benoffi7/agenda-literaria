---
import '@/styles/global.css';
import Encabezado, { type Seccion } from '@/components/sitio/Encabezado.astro';
import PieDePagina from '@/components/sitio/PieDePagina.astro';

interface Props {
  titulo: string;
  descripcion?: string;
  noIndex?: boolean;
  /**
   * Qué sección del sitio marcar como activa. **`'ninguna'` apaga el encabezado
   * y el pie enteros**, que es lo que necesita `/admin`: el panel es una SPA con
   * su propia navegación y meterle la del sitio público sería dos barras
   * compitiendo por el mismo lugar.
   */
  seccion?: Seccion | 'ninguna';
}

const { titulo, descripcion, noIndex = false, seccion = 'ninguna' } = Astro.props;
const conChrome = seccion !== 'ninguna';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover: deja que la página pinte detrás del notch y de la
         barra de gestos del iPhone. Lo que no puede quedar tapado se separa
         con env(safe-area-inset-*) desde el CSS. -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    {/* El papel del sistema (`#fbf9f4`), el mismo que `--color-papel`. */}
    <meta name="theme-color" content="#fbf9f4" />
    <title>{titulo}</title>
    {descripcion && <meta name="description" content={descripcion} />}
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/*
      Las tres familias de `docs/referencias/sistema-visual.md`, en **una sola**
      petición — B-260. Pesan 58,8 KB contra los 84,2 KB de Inter + Lora, y eso
      está medido sobre los woff2 que Google sirve para el subset latin, no
      estimado. El detalle de la medición está en `src/styles/global.css`.

      **`opsz` va fijado en 48 y no abierto**: con el eje óptico abierto, Bodoni
      Moda pasa de 14,6 KB a 26,5 KB —casi el doble de la familia entera— y no
      hace falta, porque acá se usa en un rango angosto: 26px la marca y 72px el
      mes. 48 es el punto óptico del medio de ese rango.
    */}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo+Narrow:wght@400..700&family=Bodoni+Moda:opsz,wght@48,800&family=Public+Sans:wght@400..700&display=swap"
    />
  </head>
  {/*
    `overflow-x-clip` y no `-hidden` — B-259. Los dos recortan igual, pero `hidden`
    **crea un contenedor de scroll** y eso rompe `position: sticky` adentro, en
    silencio: el elemento simplemente nunca se pega, sin error ni advertencia. Lo
    encontró el frente del detalle, que terminó usando `fixed` con un relleno al
    pie para esquivarlo. `clip` no crea el contenedor, así que `sticky` vuelve a
    estar disponible para quien lo necesite.
  */}
  <body class="flex min-h-dvh flex-col overflow-x-clip font-sans antialiased">
    {conChrome && <Encabezado activa={seccion as Seccion} />}
    {/* `flex-1` empuja el pie al fondo cuando la página es más corta que la
        pantalla — un listado filtrado a cero resultados es el caso normal. */}
    <div id="contenido" class="flex-1">
      <slot />
    </div>
    {conChrome && <PieDePagina />}
  </body>
</html>
