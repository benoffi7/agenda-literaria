rules_version = '2';

// §5.3 — los custom claims (`admin`, `publicador`) se setean una sola vez con el
// Admin SDK (scripts/set-admin-claim.mjs). Sin uno de esos claims no hay
// escritura posible.
service cloud.firestore {
  match /databases/{database}/documents {

    /*
     * ══ LOS DOS ROLES DEL PANEL — B-888 ══════════════════════════════════
     *
     * `admin` es el de siempre: ve y toca todo. `publicador` es el rol acotado —
     * **gestiona solo las actividades que él mismo creó**, y las publica sin que
     * nadie revise. Todo lo demás del panel (reportes, propuestas, taxonomías,
     * tablero, historial) le está cerrado acá, en las reglas, y no en la UI:
     * **que el panel esconda un botón no impide nada** a quien abra la consola de
     * Firebase con su propia sesión (es el mismo razonamiento de D-128, que cerró
     * una puerta que ninguna proyección atravesaba).
     *
     * Cruza el umbral que B-28 dejó escrito —«la confianza, no la cantidad:
     * vuelve cuando entre una tercera cuenta que no sea de confianza»— y por eso
     * el rol existe como claim y no como convención.
     *
     * ── El orden de las guardas, que es lo que hace que el rol se ejerza ──
     * Cada regla de abajo se lee `esAdmin() || (esPublicador() && …)`, y `||`
     * cortocircuita: **si `esAdmin()` diera true para una cuenta que además es
     * publicadora, la rama acotada no se evaluaría nunca** y el rol nuevo sería
     * decorativo. Por eso `esAdmin()` exige, además del claim, **no ser
     * publicador**: un token con los dos claims —que solo puede salir de un error
     * del operador, porque `setCustomUserClaims` reemplaza el objeto entero y
     * nunca lo fusiona— cae del lado **acotado**, que es la dirección en la que
     * conviene fallar. El caso está en `tests/rol-publicador.integracion.test.ts`.
     *
     * `token.get('publicador', false)` y no `token.publicador`, por el mismo
     * motivo que ya decía `esAdmin()`: leer una clave ausente de un map es un
     * evaluation error, no `false`, y el cliente recibe "evaluation error" en
     * lugar de un permission-denied limpio.
     */
    function esPublicador() {
      return request.auth != null && request.auth.token.get('publicador', false) == true;
    }

    function esAdmin() {
      return request.auth != null
        && request.auth.token.get('admin', false) == true
        && !esPublicador();
    }

    /** Cualquiera de los dos roles: lo que hoy significa «tiene acceso al panel». */
    function esDelPanel() {
      return esAdmin() || esPublicador();
    }

    /*
     * ══ QUIÉN ES CADA UID — B-888 ════════════════════════════════════════
     *
     * `/actividades` guarda `createdBy`/`updatedBy`, que son **uids**: el panel no
     * tiene con qué decir «la cargó fulano». D-610 ya decidió que el mail **no
     * entra al documento de la actividad**, y esa decisión no se toca: los dos
     * costos que la fundaron —un dato personal más del que acordarse en cada
     * salida pública (§5.1), y el mail copiado dentro de cada versión del §12, o
     * sea imborrable— son costos del **campo en `/actividades`**, no del dato.
     *
     * Acá el mail vive **una vez, en su propia colección**, fuera de la
     * proyección pública y fuera del historial: se renombra una cuenta y se
     * arregla en un lugar, no en doscientos documentos ni en sus versiones.
     *
     * ── Por qué se le puede creer al mail (y por qué no hace falta una Function)
     * `d.email == request.auth.token.get('email', '')`. Ese `email` **no es un
     * dato que mande el cliente**: es un claim del ID token que emite Identity
     * Platform y que sale del registro de la cuenta. Se verificó contra el
     * emulador que **ni siquiera un developer claim llamado `email` en un custom
     * token lo pisa** — el token emitido sigue trayendo el mail de la cuenta. O
     * sea que forjarlo exige la service account, y quien la tiene ya no necesita
     * esta colección para nada.
     *
     * `email_verified` es la otra mitad, y es la que importa el día que alguien
     * habilite el proveedor de mail+contraseña en la consola: con Google el login
     * llega siempre verificado, pero un alta con contraseña deja elegir la
     * dirección **sin probarla**, y sin esta cláusula esa cuenta podría
     * presentarse con el mail de otra persona del equipo.
     *
     * Una Function no agrega nada acá y sí quita: la autorización real son las
     * reglas (es lo que dice el bloque de `/reportes` más abajo), y un `onCall`
     * tendría que revalidar a mano exactamente lo que estas cuatro líneas ya
     * verifican contra el token.
     *
     * ── El uid del path es la guarda, y no `resource.data` ────────────────
     * `uid == request.auth.uid` condiciona por la **ruta**, no por el contenido:
     * no reintroduce el mecanismo de la trampa 7 (una condición sobre
     * `resource.data` obliga a que toda query traiga el `where` correspondiente).
     * La contracara es que un publicador no puede **listar** `/usuarios`: pide su
     * propio documento por id. El único que lista es el admin, y para él la regla
     * no mira contenido.
     */
    /*
     * ── Cuatro cláusulas, y ninguna de adorno ─────────────────────────────
     * El primer borrador tenía siete: copiaba de `propuestaValida()` el `hasAll`,
     * el `is string` y el tope de largo. **Tres de esas no podían fallar**, y la
     * mutación las delató (`hasAll` daba verde con el aserto puesto). El motivo es
     * que las dos funciones no se parecen en lo que importa: `propuestaValida()`
     * acota **texto libre de un desconocido**, y acá el `email` no es un valor que
     * el cliente elija —tiene que ser **idéntico a un claim del token**—, así que
     * el tipo y el largo ya los decidió el alta de la cuenta.
     *
     *  - `hasAll` es letra muerta: una clave ausente la agarra la comparación de
     *    abajo, porque `.get(clave, default)` devuelve el default y el default
     *    **no puede ser igual** al mail del token. (En `revisionValida()` sí
     *    frena, y ahí está dicho por qué: allá `null` es un valor legítimo.)
     *  - `is string` tampoco: un valor de otro tipo no es igual al mail del
     *    token, así que la comparación de abajo lo rechaza igual.
     *  - Y el tope de largo tampoco: el único mail que pasa es el de la cuenta, y
     *    ése lo acota Identity Platform, no nosotros.
     *
     * ── La cuarta cláusula **no** es de adorno, y creerlo duró un borrador ──
     * `size() > 0` estuvo a punto de irse con las otras tres, con este
     * argumento: «queda cubierto por `email_verified`, que no puede ser true en
     * una cuenta sin dirección». Lo marcó el `auditor-privacidad` como un
     * **supuesto sobre Identity Platform declarado sin verificar**, se probó
     * contra el emulador, y es **falso**: una cuenta creada con `emailVerified:
     * true` y **sin** `email` emite un token con `email_verified: true` y sin
     * claim `email`. Ahí `.get('email','')` da `''` en los dos lados, `'' == ''`
     * es true, y el registro entraría con el mail vacío.
     *
     * O sea que la cláusula que parecía la más obvia de borrar era la única de
     * las cuatro que tapaba un caso que ninguna otra tapa. Tiene su testigo en
     * `tests/usuarios.integracion.test.ts`.
     */
    function usuarioValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['email', 'actualizadoEn'])
        && d.get('email', '').size() > 0
        && d.get('email', '') == request.auth.token.get('email', '')
        && request.auth.token.get('email_verified', false) == true
        // Con `request.time` el cliente no puede antedatar el registro.
        && d.get('actualizadoEn', null) == request.time;
    }

    match /usuarios/{uid} {
      // El admin los lee todos (es lo que le pinta el filtro «quién lo creó» y la
      // marca de autoría). Un publicador lee **el suyo**, y nadie más lee nada:
      // es el directorio de las cuentas del equipo, no una salida pública.
      allow read: if esAdmin() || (esPublicador() && uid == request.auth.uid);

      // Cada cuenta se registra a sí misma, con su propio mail del token. No hay
      // forma de escribir el documento de otro: el uid del path tiene que ser el
      // del que escribe.
      allow create, update: if esDelPanel() && uid == request.auth.uid && usuarioValido();

      /*
       * **El registro sobrevive al claim, y es a propósito.** Las actividades que
       * cargó una cuenta siguen existiendo cuando se le saca el permiso, y su
       * `createdBy` las sigue señalando: borrar el documento dejaría al panel
       * mostrando un uid pelado en trabajo que sí pasó. Si alguna vez hay que
       * borrar de verdad a una persona, es un `delete` con el Admin SDK — una
       * decisión explícita, no un botón.
       */
      allow delete: if false;
    }

    match /actividades/{id} {
      /*
       * Solo el admin lee — D-128, desvío deliberado del §5.3 del `CLAUDE.md`,
       * que prescribía `allow read: if resource.data.estado == 'publicado'`.
       *
       * Esa condición era coherente con §2.4/§2.5 (el público hace UN fetch de
       * `events.json` y CERO lecturas de Firestore), pero dejaba la puerta
       * abierta igual — y **las reglas son todo-o-nada por documento: no
       * filtran campos**. Con la API key web —pública por diseño y versionada
       * en `.env.production` de un repo público— un anónimo hacía la query con
       * el `where('estado','==','publicado')` y recibía el documento ENTERO:
       * `online.url` con `urlPublica:false`, `difusion.notas` y `arrobar`, la
       * URL del material con `publico:false`, `createdBy`/`updatedBy`,
       * `sesiones[].calendarEventId` y `imagenes[].storagePath`. Es la lista
       * completa del §5.1, salteando `toPublic` por completo.
       *
       * O sea: toda la maquinaria de proyección estaba cuidando una puerta que
       * tenía otra abierta al lado. Se reprodujo contra el emulador antes de
       * tocar esto, y los dos `it` de `actividades.integracion.test.ts` lo
       * fijan — uno por documento y otro por query, porque son dos permisos
       * distintos.
       *
       * No rompe nada: el panel siempre está logueado, y el sitio público
       * (B-01) sirve el `events.json` que produce el build con el Admin SDK. Si
       * alguna vez hace falta lectura en vivo desde el cliente, el camino **no**
       * es volver a esta regla: es sacar los campos privados del documento (una
       * subcolección `privado/{doc}` con `allow read: if esAdmin()`), porque una
       * regla no puede proyectar.
       *
       * Nota del emulador, que importa para escribir los tests: cuando la
       * **lectura** se deniega, el `message` de la `FirebaseError` no es
       * "Missing or insufficient permissions" —eso es de las escrituras— sino la
       * traza de evaluación (`false for 'get' @ L50`), o directamente
       * `Property estado is undefined on object` cuando la regla no se puede
       * evaluar. Pero el **`code` sí es `permission-denied`** en todos esos
       * casos, y es `unavailable` si el emulador no está.
       *
       * Por eso los tests de lectura afirman el `code` y no el mensaje
       * (`rechazadaPorPermisos` en `actividades.integracion.test.ts`): un
       * `rejects.toThrow()` pelado lo satisface un emulador caído, y un matcher
       * por mensaje falla contra la traza. Se probó en las dos direcciones.
       */
      /*
       * ── Y el publicador lee **las suyas**, con la trampa 7 a la vista ─────
       * B-888. `allow read` **incluye el `list`**, y una condición sobre
       * `resource.data` obliga a que toda query la traiga como `where`: sin
       * `where('createdBy','==',uid)` Firestore **rechaza la query entera**, no
       * filtra (trampa 7, y trampa 13 en Storage). O sea que el listado del panel
       * para un publicador tiene que ser esa query y no el barrido de hoy — y
       * `listarActividades()` ordena por `updatedAt`, así que hace falta el índice
       * compuesto `createdBy ASC, updatedAt DESC` que se agregó a
       * `firestore.indexes.json`. Es el trabajo de la tajada 2; acá queda dicho
       * porque la regla es la que lo obliga.
       *
       * El otro efecto, y hay que saberlo: `slugDisponible()`
       * (`src/lib/actividades.ts`) barría **toda** la colección sin `where`, así
       * que para un publicador esa query se rechazaba entera. El slug único es un
       * invariante de todo el catálogo y no se puede verificar mirando solo lo
       * propio. **Lo resolvió la tajada 2 con `/slugs/{slug}`** — el bloque está
       * más abajo en este archivo, con el descarte de la Function anotado.
       *
       * `.get('createdBy', '')` y no `resource.data.createdBy`, y esto se probó
       * contra el emulador en las dos formas: las dos sirven para el análisis de
       * la query (la lista con el `where` correcto pasa igual), pero el acceso
       * directo devuelve `Property createdBy is undefined on object` sobre un
       * documento anterior al campo, y con el default el rechazo es limpio. Es el
       * mismo idiom que `esAdmin()` y por el mismo motivo.
       */
      allow read: if esAdmin()
        || (esPublicador() && resource.data.get('createdBy', '') == request.auth.uid);

      /*
       * ── Las tres escrituras, separadas porque el dueño se verifica distinto ──
       *
       * Un publicador **nace dueño** de lo que crea y no puede dejar de serlo ni
       * volverse dueño de lo ajeno. Cada una de esas dos mitades es una cláusula,
       * y las dos hacen falta:
       *
       *  - en el `create`, `request.resource.data.createdBy == uid`: nadie carga
       *    una actividad a nombre de otro;
       *  - en el `update`, el dueño se mira en el documento **previo**
       *    (`resource.data`), así que una actividad ajena no se puede tomar
       *    escribiéndole el `createdBy` propio: la regla ya falló antes de mirar
       *    lo que se quiere escribir;
       *  - y además `createdBy` **no puede cambiar** en el update, o sea que
       *    tampoco se puede regalar la propia. Sin esa cláusula un publicador
       *    podría empujar contenido al nombre de otra cuenta —incluido un admin—
       *    y perder de vista lo que cargó.
       *
       * **`updatedBy` tiene que ser el propio**, que es la otra mitad de la marca
       * de autoría: desde B-888 el panel muestra el mail de quien tocó el
       * documento por última vez, así que dejarlo libre sería dejar firmar a
       * nombre de otro. Los tres caminos de escritura del panel ya lo escriben
       * siempre (`formADocumento`, `marcarCupoCompleto`, `restaurarCampo`), así
       * que la cláusula no rompe nada y fija lo que hoy es costumbre.
       *
       * **Lo que a propósito NO se restringe: `estado`.** El pedido del dueño es
       * que lo que carga un publicador salga publicado sin que nadie revise, y que
       * pueda publicar, despublicar y volver a borrador lo suyo. Si alguna vez hay
       * que moderar, la cláusula va acá y no en el panel.
       *
       * El admin queda como estaba —puede todo, incluido reasignar un
       * `createdBy`—: no es una omisión, es el rol que ya existía.
       */
      allow create: if esAdmin()
        || (esPublicador()
             && request.resource.data.get('createdBy', '') == request.auth.uid
             && request.resource.data.get('updatedBy', '') == request.auth.uid);

      allow update: if esAdmin()
        || (esPublicador()
             && resource.data.get('createdBy', '') == request.auth.uid
             && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
             && request.resource.data.get('updatedBy', '') == request.auth.uid);

      /*
       * Borrar lo propio sí, y es una decisión y no un descuido: `estado:
       * 'borrador'` ya saca una actividad del sitio y de Calendar (§7.3), así que
       * negar el borrado no protegería nada —solo dejaría al publicador
       * acumulando— y el §12 guarda la versión del borrado (B-41), que es de donde
       * se recupera. Lo ajeno, no: es la misma cláusula del update.
       */
      allow delete: if esAdmin()
        || (esPublicador() && resource.data.get('createdBy', '') == request.auth.uid);

      /*
       * §12 — historial de versiones. Solo lo escribe la Function con Admin SDK.
       *
       * **Y sigue siendo solo del admin, también con el rol nuevo** (B-888). El
       * panel del publicador es su listado más la vista de calendario; el
       * historial es una de las pantallas que no ve, así que la regla dice lo
       * mismo que la UI en vez de contradecirla.
       *
       * Y si algún día hay que abrirlo, el problema no es encontrar el dueño —el
       * documento de la versión guarda el documento entero, así que lo tiene en
       * `documento.createdBy`— sino que **`read` incluye `list`**: el historial se
       * lista, y con una condición sobre `resource.data` esa query necesitaría
       * `where('documento.createdBy','==',uid)` y su índice, o un `get()` al
       * documento padre desde la regla (que se factura como lectura en cada
       * evaluación). Nada de eso hace falta hoy.
       */
      match /versiones/{version} {
        allow read: if esAdmin();
        allow write: if false;
      }
    }

    /*
     * ══ EL ÍNDICE DE SLUGS — B-888, tajada 2 ═════════════════════════════
     *
     * **Qué problema resuelve.** `slugDisponible()` barría toda la colección sin
     * `where`, y con la regla de `/actividades` de arriba esa query se le rechaza
     * **entera** a un publicador (trampa 7). Y no tiene arreglo dentro de la
     * regla: el slug único es un invariante de **todo** el catálogo, y una regla
     * es todo-o-nada por documento — no puede contestar «¿existe otra actividad
     * con este slug?» mirando solo lo propio.
     *
     * ── Por qué esta colección y no una Function (D-660) ──────────────────
     * La alternativa escrita en B-888 era un `onCall` que hiciera la query con el
     * Admin SDK. Se descartó por tres cosas, y la tercera es la que decide:
     *
     *  1. **Ninguna acción del panel bloquea hoy sobre una Function.** Las cinco
     *     que existen son asíncronas y best-effort (el historial, el sync, la
     *     optimización, el rebuild, los issues): si una se cae, el panel sigue
     *     guardando. Meter una en el camino sincrónico del guardado —la acción
     *     más usada— sería el primer lugar donde un cold start deja a alguien sin
     *     poder guardar.
     *  2. **El CI no la podría probar.** `push-main.yml` levanta
     *     `--only auth,firestore,storage`, así que un `onCall` en el camino de
     *     guardado de **todos** los roles sería el único paso del guardado que
     *     nada ejercita. Esto, en cambio, es Firestore: lo prueban los emuladores
     *     que ya corren, con `cargarReglas()` y con mutaciones.
     *  3. **Y la dirección en la que falla.** Un `onCall` es check-then-write,
     *     igual que el barrido de hoy: dos guardados simultáneos con el mismo
     *     slug pasan los dos. Acá la unicidad la decide el **servidor**: un
     *     `create` sobre un documento que existe es un `update`, y `update` está
     *     en `false`. O sea que esto no reemplaza el chequeo: lo convierte en un
     *     invariante. Es lo único de toda la tajada que deja el catálogo mejor
     *     que antes de que existiera el rol.
     *
     * ── Lo que hay que saber para no romperlo ─────────────────────────────
     * **El índice es una segunda derivación del slug, y esa clase de cosa se
     * desincroniza** (B-88). Lo que la sostiene es que se escribe en los mismos
     * cuatro lugares que escriben el slug —crear, editar cuando cambió, borrar y
     * restaurar del historial—, centralizados en `src/lib/slugs.ts`, y que
     * **todas sus formas de fallar fallan cerradas**: una reserva que queda
     * huérfana hace que un nombre no se pueda usar (visible, y lo libera
     * `scripts/sembrar-slugs.mjs --reparar`), nunca que dos actividades compartan
     * una URL — que es el daño de la trampa 10.
     *
     * **Y la siembra es obligatoria**: las actividades que ya existen no tienen
     * reserva, así que sin correr el script sus slugs se leerían como libres. Por
     * eso el script deja `/slugs/_indice`, y el panel **se niega a guardar** si
     * ese documento no está, en vez de creer que todo está libre. El `_` lo hace
     * inalcanzable como slug: `slugify` solo produce `[a-z0-9-]`, que es lo mismo
     * que exige el `matches` del `create` de abajo.
     *
     * `list` en `false` y no en `esDelPanel()`: enumerar el índice es enumerar
     * las direcciones web de **todos** los borradores, que es justo lo que
     * `/actividades` le cierra a un publicador. Se llega por id o no se llega.
     *
     * ── Los dos límites que esto ACEPTA, dichos al derecho ────────────────
     * Los marcó el `auditor-privacidad`, y van escritos porque el resto de este
     * bloque argumenta largo lo que cierra y no decía nada de lo que deja pasar.
     *
     *  1. **Un `get` entrega la reserva entera, `porUid` incluido.** Una regla es
     *     todo-o-nada por documento y no proyecta (es D-128 otra vez), así que un
     *     publicador que pregunte por un slug —y los publicados están en la URL
     *     del sitio— se entera de **qué uid** lo reservó, incluido el de un admin.
     *     No hay arreglo estrecho: condicionar el `get` por `porUid` rompería la
     *     unicidad, porque el publicador **tiene que** poder saber que un nombre
     *     ajeno está tomado. Lo que se entrega es un uid pelado, que él no puede
     *     resolver a un mail (el directorio le está cerrado). Se acepta, y tiene
     *     su caso positivo en `tests/rol-publicador.integracion.test.ts` para que
     *     el día que alguien intente cerrarlo se vea qué se rompe.
     *  2. **Un publicador puede reservar un nombre sin cargar la actividad.**
     *     `reservaValida()` no verifica que `actividadId` exista: hacerlo pediría
     *     un `get()` a `/actividades` desde la regla, facturado en cada
     *     evaluación. O sea que puede tomar `taller-de-poesia-2027` y nadie más lo
     *     puede usar. Falla **cerrada** —un nombre que nadie puede usar, nunca dos
     *     actividades con la misma URL— y lo barre
     *     `scripts/sembrar-slugs.mjs --reparar`, que saca toda reserva sin
     *     actividad viva. Es el mismo tipo de límite aceptado que `storage.rules`
     *     declara para su prefijo plano.
     */
    /*
     * **Tres cláusulas y ninguna de adorno, igual que `usuarioValido()`.** El
     * primer borrador tenía cinco, y **dos no podían fallar**. La primera la marcó
     * el `auditor-privacidad`; la segunda la delató la mutación al ir a probarlas:
     *
     *  - **`hasAll` de las tres claves** (copiado de `propuestaValida()`): si falta
     *    `actividadId`, el `.get()` da `''` y lo agarra el `size() > 0`; si falta
     *    `porUid`, `'' == request.auth.uid` es false (con `esDelPanel()` el uid
     *    nunca es vacío); si falta `creadoEn`, `null == request.time` es false.
     *  - **`actividadId is string`**: un valor de otro tipo no tiene `.size()`, así
     *    que lo rechaza igual el `size() > 0` de abajo —por un *evaluation error*,
     *    que deniega—. Es **exactamente** el mismo caso que el `is string` que se
     *    borró de `usuarioValido()` tres funciones más arriba, y por el mismo
     *    motivo.
     *
     * Una cláusula que no puede fallar en una regla de seguridad es peor que
     * ninguna: se lee como load-bearing y el que venga la va a cuidar en vez de
     * mirar la que sí frena. Las tres que quedan se pueden mutar, y cada una tiene
     * su caso en `tests/rol-publicador.integracion.test.ts`.
     */
    function reservaValida(slug) {
      let d = request.resource.data;
      return d.keys().hasOnly(['actividadId', 'porUid', 'creadoEn'])
        // El alfabeto de `slugify`. Deja afuera al centinela `_indice`, que solo
        // escribe el Admin SDK, y a cualquier id inventado a mano.
        && slug.matches('^[a-z0-9-]+$')
        && d.get('actividadId', '').size() > 0
        && d.get('actividadId', '').size() <= 200
        // Igual que `reportadoPor.uid` y `revision.porUid`: nadie reserva a
        // nombre de otro. Es lo que hace verificable el `delete` de abajo.
        && d.get('porUid', '') == request.auth.uid
        // Con `request.time` el cliente no puede antedatar la reserva.
        && d.get('creadoEn', null) == request.time;
    }

    match /slugs/{slug} {
      allow get: if esDelPanel();
      allow list: if false;

      allow create: if esDelPanel() && reservaValida(slug);

      /*
       * **`update` en `false`, y es la cláusula entera de la unicidad.** No es
       * simetría ni prolijidad: es lo que hace que un `setDoc` sobre un slug ya
       * reservado sea un `update` y lo rechace el servidor. Aflojarlo a
       * `esDelPanel()` deja que el segundo guardado pise la reserva del primero y
       * la colección pasa a ser un registro de intenciones en vez de un índice.
       */
      allow update: if false;

      /*
       * Liberar el nombre: al borrar la actividad, y al cambiarle el slug antes
       * de publicarla (trampa 10 — después de publicar no se cambia).
       *
       * El publicador libera **las suyas**, por `porUid`, que es el mismo dato que
       * el `create` obliga a que sea el propio. No se mira el dueño de la
       * actividad —eso pediría un `get()` a `/actividades` desde la regla, que se
       * factura como lectura en cada evaluación, y es lo mismo que el bloque de
       * `versiones` ya descartó—. La consecuencia está dicha en `slugs.ts`: si un
       * admin le renombró el slug a la actividad de un publicador, la reserva
       * queda a nombre del admin y el publicador no la puede liberar al borrar.
       * Falla cerrada (un nombre que no se puede reusar) y la barre el script.
       */
      allow delete: if esAdmin()
        || (esPublicador() && resource.data.get('porUid', '') == request.auth.uid);
    }

    match /opciones/{campo} {
      allow read: if true;

      // §4.3 — `aprobada` decide si una opción creada con "Otro" entra al
      // desplegable de las demás cuentas. Aprobar es, a nivel de reglas, una
      // escritura más de este documento: la autoridad para aprobar es el claim
      // `admin`, el mismo que ya habilita crear la opción y editar cualquier
      // actividad.
      //
      // No se intenta una regla más fina (ej.: "solo el dueño puede aprobar")
      // porque las reglas no pueden inspeccionar qué elemento del array cambió:
      // `valores` llega como un array de maps y no hay forma de compararlo
      // elemento por elemento contra el anterior. Una regla que no puede
      // verificar lo que promete es peor que no tenerla. Si en algún momento
      // hace falta separar "quien carga" de "quien valida", el camino es un
      // claim aparte (`curador`) y mover la aprobación a un solo campo o a un
      // documento propio, que sí es verificable.
      //
      /*
       * **El publicador no escribe acá, y es por el párrafo de arriba** (B-888).
       * `/opciones/{campo}` es un documento **compartido por todo el sitio**: los
       * chips de filtro salen de él (§4.4) y renombrar una etiqueta cambia lo que
       * ve el público. Y como las reglas no pueden inspeccionar qué elemento del
       * array `valores` cambió, darle `write` no sería «puede agregar una opción
       * con Otro»: sería **puede reescribir la taxonomía entera** —borrar valores,
       * dar vuelta `fijo`, aprobar lo que quiera— sin una sola cláusula que lo
       * verifique. Una regla que no puede verificar lo que promete es peor que no
       * tenerla, que es lo que ya decía este bloque.
       *
       * Tenía una consecuencia concreta para la tajada 2: `upsertOpcion()` y
       * `registrarUsos()` corren al guardar una actividad (D-02), así que **con
       * este rol esas dos escrituras se rechazan** — y el `catch` de
       * `registrarUsos` es mudo a propósito, o sea que fallarían en silencio en
       * cada guardado.
       *
       * **Resuelto en la tajada 2, en los dos lados**: el panel no le ofrece
       * «Otro…» (`campos-del-panel.tsx`, con el store de `lib/rolActivo.ts`) y el
       * guardado saltea las dos escrituras (`formulario/guardar.ts`, con el rol
       * por parámetro). Si algún día el dueño quiere que los `usos` de este rol
       * **sí** cuenten, el camino sigue siendo mover el incremento a una Function:
       * es el único lugar donde se puede verificar que lo único que cambió del
       * array fue un contador.
       */
      allow write: if esAdmin();
    }

    function reporteValido() {
      let d = request.resource.data;
      let campos = ['tipo', 'titulo', 'descripcion', 'pasos', 'severidad', 'actividad',
                    'contexto', 'reportadoPor', 'estado', 'intentos', 'github', 'error',
                    'creadoEn'];
      return d.keys().hasOnly(campos) && d.keys().hasAll(campos)
        && d.tipo in ['bug', 'sugerencia']
        && d.titulo is string && d.titulo.size() >= 6 && d.titulo.size() <= 120
        && d.descripcion is string && d.descripcion.size() >= 15 && d.descripcion.size() <= 4000
        && (d.pasos == null || (d.pasos is string && d.pasos.size() <= 2000))
        && (d.severidad == null || d.severidad in ['me-bloquea', 'molesta', 'menor'])
        && (d.actividad == null || d.actividad.keys().hasOnly(['id', 'titulo']))
        && d.contexto.keys().hasOnly(['versionPanel', 'navegador', 'ventana',
                                      'zonaHoraria', 'url', 'pantalla'])
        // B-363 — `contexto.pantalla` es el único subcampo de `contexto` que la
        // Function pasa por `desSlug()` ANTES del saneador (`functions/reportes.js`).
        // `desSlug` reemplaza `-` por espacios, y eso le desafina los patrones al
        // saneador: `https://mi-org.zoom.us/…` → `Https://mi org.zoom.us/…` ya no
        // matchea `LINK_REUNION` (que no cruza un espacio), y se publicaría
        // legible. `severidad` no corre este riesgo porque ya está acotado arriba
        // por `in [...]`; `pantalla` no lo estaba. Acotarlo acá es más simple que
        // reordenar el armado del issue (`redactar` corre sobre el cuerpo entero,
        // no por campo — D-197), y cierra la única vía por la que ese campo podía
        // traer algo que no sea uno de los cinco valores fijos de `PANTALLAS`
        // (`src/types/reporte.ts`). `.get()` con default porque `contexto` no
        // fuerza `pantalla` con `hasAll`, así que puede venir ausente.
        && d.contexto.get('pantalla', 'listado')
             in ['listado', 'nueva-actividad', 'editar-actividad', 'encuentros', 'otra']
        // §5.1 — el uid queda acá y no sale al issue. Que sea el propio evita
        // que un admin cargue un reporte a nombre del otro.
        && d.reportadoPor.keys().hasOnly(['uid', 'email'])
        && d.reportadoPor.uid == request.auth.uid
        && d.estado == 'pendiente'
        && d.intentos == 0
        && d.github == null
        && d.error == null
        // Con `request.time` el cliente no puede antedatar el reporte.
        && d.creadoEn == request.time;
    }

    /**
     * B-31 — el único cambio que el panel puede hacerle a un reporte ya creado:
     * volver a intentar la publicación de uno que quedó en `error`.
     *
     * El ciclo de vida sigue siendo de la Function; esto no lo abre, agrega
     * **una** transición y la deja verificable en la regla misma. Cinco
     * condiciones, y cada una tapa una forma de hacer daño:
     *
     *  - `estado == 'error'` de partida: no se puede "reintentar" algo que está
     *    en vuelo (`enviando`) ni ya publicado, que es como se crearían dos
     *    issues del mismo reporte.
     *  - `github == null` de partida: defensa en profundidad de lo mismo. Si el
     *    documento ya tiene número de issue, no hay nada que reintentar.
     *  - solo cambian cuatro campos: el texto del reporte —lo que va al repo
     *    PÚBLICO— no se puede editar por este camino. Reintentar publica lo
     *    mismo que se guardó, no otra cosa.
     *  - `intentos == 0`: es lo que hace que el reintento sirva. `decidirAccion`
     *    de `functions/reportes.js` ignora un reporte con los intentos
     *    agotados, así que mover solo el estado dejaría el botón sin efecto en
     *    el caso más común (falló tres veces por un token vencido).
     *  - `error == null`: se limpia el mensaje del fallo anterior, que si no
     *    queda contradiciendo al estado nuevo en la pantalla.
     *
     * Borrar sigue prohibido: un reporte es el pedido de una persona, y el
     * panel no tiene por qué poder hacerlo desaparecer.
     */
    function reintentoValido() {
      let d = request.resource.data;
      let previo = resource.data;
      // Todo con `.get(clave, default)` y no con acceso directo, por el mismo
      // motivo que `esAdmin()`: leer una clave ausente de un map es un
      // evaluation error, no `false`. `actualizadoEn` es el caso real —es
      // opcional en el documento— y `github` lo sería en un documento anterior
      // al campo.
      //
      // Igual que en `/actividades`, el emulador sigue reportando "evaluation
      // error" en algunos rechazos: evalúa ramas que la conjunción no necesita.
      // Es cosmético —deniegan igual, y los siete tests de B-31 lo fijan— y no
      // se arregla escribiéndolo de otra forma: se probó con `.get()` y con
      // `keys().hasAll()`, y el log dice lo mismo.
      return previo.get('estado', '') == 'error'
        && previo.get('github', null) == null
        && d.diff(previo).affectedKeys()
             .hasOnly(['estado', 'intentos', 'error', 'actualizadoEn'])
        && d.get('estado', '') == 'pendiente'
        && d.get('intentos', -1) == 0
        && d.get('error', 'no vino') == null
        && d.keys().hasAll(['actualizadoEn'])
        && d.actualizadoEn == request.time;
    }

    /**
     * B-580 — el segundo (y único otro) cambio que el panel puede hacerle a un
     * reporte ya creado: marcarlo resuelto, o reabrirlo.
     *
     * El dueño pidió que la pantalla de reportes deje de mostrar todo lo que
     * se cargó alguna vez y refleje solo los abiertos. La alternativa —que un
     * issue cerrado en GitHub marque el reporte solo— es la sync
     * GitHub→Firestore que el dueño **descartó** en esta misma tanda (B-30,
     * "dejamos como está") y que además el §2.1 del `CLAUDE.md` ya prohíbe
     * para Calendar por el mismo motivo (D-310): Firestore es la única fuente
     * de verdad, y quien cierra el reporte es un admin desde el panel.
     *
     * Mismo criterio que `reintentoValido`, con `resuelto` en vez del ciclo
     * de vida de envío:
     *
     *  - solo pueden cambiar `resuelto` y `actualizadoEn`: el texto, el
     *    estado de envío y el resto del documento no se tocan por acá.
     *  - `resuelto` tiene que estar de verdad en el diff (`hasAny`), y no
     *    solo `actualizadoEn` — una escritura que no cambia nada de lo que
     *    esta regla habilita no tiene motivo para pasar por ella.
     *  - `resuelto` tiene que ser un booleano: cualquier otro tipo (string,
     *    número) rompería el filtro `!r.resuelto` del panel de formas raras.
     *  - sin condición sobre el `resuelto` PREVIO, a propósito: al revés que
     *    el reintento (que es una transición de un solo sentido,
     *    `error`→`pendiente`), acá las dos direcciones son válidas — marcar
     *    resuelto y reabrir son la misma operación de escritura, y el botón
     *    del panel manda el valor que corresponda.
     */
    function resueltoValido() {
      let d = request.resource.data;
      let previo = resource.data;
      return d.diff(previo).affectedKeys().hasOnly(['resuelto', 'actualizadoEn'])
        && d.diff(previo).affectedKeys().hasAny(['resuelto'])
        && d.get('resuelto', null) is bool
        && d.keys().hasAll(['actualizadoEn'])
        && d.actualizadoEn == request.time;
    }

    // Reportes del panel (bugs y sugerencias). Los crea un admin desde
    // /admin y la Function `reporteAIssue` los publica como issue de GitHub.
    //
    // Las reglas son la autorización real: por eso la Function es un trigger
    // de Firestore y no un `onCall` que tenga que revalidar el claim a mano.
    //
    // Se valida la forma del documento, no solo quién escribe: el reporte
    // termina en un repo PÚBLICO, y el estado inicial es lo que decide si la
    // Function lo toma. Sin esto, un admin distraído (o un script con su
    // token) podría crear un reporte que nace "creado", o con los intentos
    // gastados, y nunca se publicaría.
    match /reportes/{id} {
      // Los admins leen todos los reportes: es una bandeja compartida.
      //
      /*
       * **Cerrada al publicador, las tres** (B-888), y no por simetría sino por lo
       * que hay adentro. Un reporte lleva `reportadoPor.email` —el mail de otra
       * cuenta del panel— y texto libre que alguien tipeó mientras le fallaba algo;
       * la bandeja es compartida entre los que la comparten. Y el `read` es
       * todo-o-nada por documento: no hay forma de entregar «solo los suyos» sin
       * una condición sobre `resource.data` que además arrastraría el `where` de la
       * trampa 7 a la pantalla de reportes.
       *
       * Que un publicador pueda reportar un bug es razonable y se decide con el
       * dueño, no acá: sería un `create` propio, con `reportadoPor.uid ==
       * request.auth.uid` —que la regla ya exige— y **sin** abrir el `read`.
       */
      allow read: if esAdmin();
      allow create: if esAdmin() && reporteValido();
      // El ciclo de vida (estado, intentos, github) lo mueve la Function con el
      // Admin SDK, que no pasa por estas reglas. Las únicas dos excepciones son
      // el reintento de B-31 y marcar/reabrir resuelto de B-580, cada una
      // acotada arriba a los campos que le corresponden.
      allow update: if esAdmin() && (reintentoValido() || resueltoValido());
      allow delete: if false;
    }

    /*
     * Lo que el backend calcula y el panel mira. Dos documentos hoy:
     *
     *  - `rebuild` — el flag de rebuild pendiente del §8;
     *  - `analitica-sitio` — el resumen diario de GA4 y Search Console
     *    (B-374/B-373), y **éste lleva contenido**: los rankings de páginas del
     *    sitio y las consultas con las que Google nos muestra, o sea texto que
     *    una persona tipeó. Por eso la lectura es de admin y no de cualquiera.
     *
     * `write: if false` para todos, incluido el admin: los dos los escribe el
     * Admin SDK desde una Cloud Function, que no pasa por reglas. Así nadie
     * puede pisarle al tablero un número inventado.
     *
     * `tests/sistema.integracion.test.ts` lo fija contra el emulador — era la
     * única colección con contenido sin test de reglas, y aflojar esto a
     * `if true` no rompía nada.
     */
    match /sistema/{doc} {
      /*
       * Sin cambios con el rol nuevo (B-888): `analitica-sitio` trae los rankings
       * de páginas y **las consultas con las que Google nos muestra**, o sea texto
       * que tipearon visitantes, y el flag de rebuild es infraestructura. Ninguna
       * de las dos cosas es «lo que él creó». El `write: if false` ya alcanza a los
       * dos roles porque no mira quién escribe.
       */
      allow read: if esAdmin();
      allow write: if false;
    }

    /*
     * ══ PROPUESTAS DE ORGANIZADORES — B-830 ══════════════════════════════
     *
     * `docs/prd/01-propuestas-de-organizadores.md`. Es la colección que va a
     * aceptar **la primera escritura anónima del proyecto**, y por eso este
     * bloque es el más delicado del archivo.
     *
     * **Hoy el `create` sigue cerrado a admin, a propósito.** Ver el comentario
     * del `allow create` más abajo: falta que App Check esté **exigiendo**
     * (B-836a, pasos del dueño), y sin eso abrir la puerta es publicar un
     * endpoint de escritura a Firestore sin nada que frene a un script.
     * `tests/escritura-anonima.integracion.test.ts` es el testigo: mientras esté
     * verde, nadie escribe sin el claim.
     *
     * La forma se valida acá y no solo en el schema de zod, por lo mismo que
     * `reporteValido()` y con más razón: del otro lado hay un anónimo, así que
     * **el schema se saltea con un `curl` y esto no**. Los números son los mismos
     * de `src/types/propuesta.ts` y los ata `tests/propuestas.test.ts`, que lee
     * este archivo.
     *
     * Lo que las reglas **no pueden** hacer, y hay que saberlo: no iteran una
     * lista, así que de `incluye` se puede acotar la cantidad y **no** el largo
     * de cada elemento. El tope de tamaño del documento (1 MB) es el techo real,
     * y la defensa de fondo es que **nada de una propuesta llega a una salida
     * pública sin que un admin la convierta en actividad**.
     */
    function fechasValidas(fechas) {
      // `hasOnly` sobre las claves de cada fila no se puede sin iterar, así que
      // lo que se acota es la cantidad y el tipo. La forma de cada fila la
      // valida el schema, y el daño posible queda en «el admin ve una fila
      // rara» — nada se publica sin que la convierta.
      return fechas is list && fechas.size() >= 1 && fechas.size() <= 12;
    }

    function lugarValido(lugar) {
      /*
       * **`hasOnly` + `hasAll`, y acá el `hasAll` sí hace falta** — lo encontró el
       * `auditor-privacidad`. Con `.get(k, '')` y solo `hasOnly`, `lugar: {}` y
       * `lugar: { barrio: 'x' }` **entraban**: el `.get()` devuelve `''` y los tres
       * asertos de tamaño pasan. Es el espejo exacto de `imagenValida()`, donde el
       * mismo `.get()` está para que el mapa vacío se **rechace**: la diferencia es
       * la cota mínima, que acá no puede estar porque el schema pide **uno** de los
       * dos primeros y no los tres.
       */
      return lugar == null || (
        lugar.keys().hasOnly(['nombre', 'direccion', 'barrio'])
        && lugar.keys().hasAll(['nombre', 'direccion', 'barrio'])
        && lugar.get('nombre', '') is string && lugar.get('nombre', '').size() <= 200
        && lugar.get('direccion', '') is string && lugar.get('direccion', '').size() <= 200
        && lugar.get('barrio', '') is string && lugar.get('barrio', '').size() <= 200
      );
    }

    function imagenValida(imagen) {
      /*
       * Una URL de afuera **o** un objeto de nuestro bucket, nunca las dos
       * (DEC-11). Dos mitades, y cada una tapa una forma distinta:
       *
       *  - **`hasOnly`** rechaza el mapa con las **dos** claves: ninguno de los
       *    dos `hasOnly` acepta la clave del otro. Verificado por mutación —
       *    sacarlo deja pasar `{url, storagePath}`.
       *  - **`.get(clave, '')` + `size() >= 1`** rechaza el mapa **vacío** y la
       *    cadena vacía. Va con `.get()` y no con acceso directo por el mismo
       *    motivo que `esAdmin()`, dicho al principio de este archivo: leer una
       *    clave ausente de un map es un *evaluation error*, no `false`. El
       *    error deniega igual, así que la regla «funcionaría» — pero por el
       *    camino equivocado, con un mensaje que no dice nada y sin una cláusula
       *    que se pueda mutar para comprobarla.
       *
       * **Acá hubo dos cláusulas que no hacían nada**, y las encontró la
       * verificación por mutación, no la lectura: primero un `size() == 1` con un
       * comentario que decía que era lo que hacía excluyente al par (falso: eso lo
       * hace `hasOnly`), y después un `hasAll` puesto para tapar el mapa vacío
       * (falso también: lo tapaba el error de evaluación). Sacar cualquiera de las
       * dos dejaba los casos en verde. Una cláusula que no puede fallar en una
       * regla de seguridad es peor que ninguna: se lee como load-bearing, y el que
       * venga la va a cuidar en vez de mirar la que sí frena.
       */
      return imagen == null || (
        (imagen.keys().hasOnly(['url'])
          && imagen.get('url', '') is string
          && imagen.get('url', '').size() >= 1 && imagen.get('url', '').size() <= 500)
        || (imagen.keys().hasOnly(['storagePath'])
          && imagen.get('storagePath', '') is string
          && imagen.get('storagePath', '').size() >= 1
          && imagen.get('storagePath', '').size() <= 500
          /*
           * **Acotado al prefijo propio, y esto no es higiene: evita borrar el
           * afiche de otra actividad.** Lo encontró el `auditor-privacidad`.
           *
           * Sin esta cláusula, con la puerta abierta un anónimo puede mandar
           * `storagePath: 'imagenes/img_<uuid>.jpg'` de una actividad **real y
           * publicada** — y el path no hay que adivinarlo: `storage.rules` deja
           * escrito que viaja adentro de la URL de descarga, y `rutaDeMiniatura`
           * lo deriva al revés desde la miniatura. Con el flujo previsto de
           * DEC-11 (rechazar → borrar la imagen), rechazar esa propuesta borra
           * el flyer de otra actividad, en vivo, y el sitio queda con la imagen
           * rota.
           *
           * Mismo idiom que el `archivo.matches(...)` de `storage.rules`. Y es un
           * escalar, no un elemento de lista, así que **acá sí se puede** — a
           * diferencia de las fechas (B-842).
           */
          && imagen.get('storagePath', '').matches('^propuestas/[A-Za-z0-9_-]+[.](jpg|jpeg|png|webp)$'))
      );
    }

    function propuestaValida() {
      let d = request.resource.data;
      let campos = ['titulo', 'descripcion', 'fechas', 'modalidad', 'lugar', 'organizador',
                    'arancel', 'inscripcion', 'incluye', 'incluyeOtro', 'imagen',
                    'contacto', 'estado', 'creadoEn', 'origen', 'revision'];
      /*
       * ── Por qué todo lo anidado se lee con `.get()` ─────────────────────
       *
       * Es el idiom que este archivo prescribe en `esAdmin()`: leer una clave
       * ausente de un map es un *evaluation error*, no `false`. El error deniega
       * igual, así que la regla «funciona» — y por el camino equivocado. Acá eso
       * importa más que en ninguna otra colección: del otro lado va a haber un
       * navegador **anónimo**, y el caso más frecuente (un campo opcional que el
       * cliente omite en vez de mandar `null`) fallaría con una traza de
       * evaluación en vez de un permission-denied limpio. `reporteValido()` ya lo
       * había resuelto así para `contexto.pantalla`; este bloque no lo seguía.
       *
       * **Y hay un efecto que es el que de verdad decide.** Con acceso directo,
       * la obligatoriedad de cada clave anidada la sostenía el error de
       * evaluación, o sea **nada declarado**: los `hasAll` que se agregaron para
       * declararla no se podían mutar —sacarlos dejaba la suite en verde— y eran
       * la clase de cláusula muerta que este mismo archivo persigue dos funciones
       * más arriba. Con `.get()`, cada `hasAll` es lo único que exige su clave, y
       * se puede verificar por mutación.
       *
       * `contacto` **no** lleva `hasAll` y no es un olvido: sus dos claves son
       * obligatorias y las exigen sus propias cotas (`via in [...]` falla con
       * `''`, y `valor.size() >= 3` también), así que un `hasAll` ahí no podría
       * fallar. Los otros cuatro mapas **sí** lo llevan, porque tienen al menos
       * un campo opcional cuyo chequeo es `== null` y pasa con la clave ausente.
       */
      return d.keys().hasOnly(campos) && d.keys().hasAll(campos)
        && d.titulo is string && d.titulo.size() >= 6 && d.titulo.size() <= 120
        && d.descripcion is string
        && d.descripcion.size() >= 15 && d.descripcion.size() <= 4000
        && fechasValidas(d.fechas)
        && d.modalidad in ['presencial', 'virtual', 'las-dos']
        && lugarValido(d.lugar)
        && d.organizador.keys().hasOnly(['nombre', 'instagram'])
        && d.organizador.keys().hasAll(['nombre', 'instagram'])
        && d.organizador.get('nombre', '') is string
        && d.organizador.get('nombre', '').size() >= 2
        && d.organizador.get('nombre', '').size() <= 200
        && (d.organizador.get('instagram', null) == null
             || (d.organizador.get('instagram', '') is string
                  && d.organizador.get('instagram', '').size() <= 200))
        && d.arancel.keys().hasOnly(['tipo', 'notas'])
        && d.arancel.keys().hasAll(['tipo', 'notas'])
        // §4.1 — solo los tres `fijo: true`. Las demás se eligen desde el panel,
        // porque crear una opción es escribir en `/opciones/*`, que es de lectura
        // pública y viaja al `events.json` (§4.2 del PRD).
        && d.arancel.get('tipo', '') in ['gratis', 'a-la-gorra', 'arancelado']
        && (d.arancel.get('notas', null) == null
             || (d.arancel.get('notas', '') is string
                  && d.arancel.get('notas', '').size() <= 200))
        && d.inscripcion.keys().hasOnly(['requiere', 'comoDice'])
        && d.inscripcion.keys().hasAll(['requiere', 'comoDice'])
        && d.inscripcion.get('requiere', null) is bool
        && (d.inscripcion.get('comoDice', null) == null
             || (d.inscripcion.get('comoDice', '') is string
                  && d.inscripcion.get('comoDice', '').size() <= 500))
        && d.incluye is list && d.incluye.size() <= 12
        && (d.incluyeOtro == null || (d.incluyeOtro is string
              && d.incluyeOtro.size() <= 200))
        && imagenValida(d.imagen)
        // El contacto de quien propone: interno, no sale nunca (§5.1, §7 del PRD).
        && d.contacto.keys().hasOnly(['via', 'valor'])
        && d.contacto.get('via', '') in ['mail', 'whatsapp', 'instagram']
        && d.contacto.get('valor', '') is string
        && d.contacto.get('valor', '').size() >= 3
        && d.contacto.get('valor', '').size() <= 200
        // El estado inicial lo fuerza la REGLA y no el cliente. Sin esto, un
        // `curl` marca su propia propuesta como aceptada y la bandeja no sirve
        // para nada (§1 del `prd/README.md`).
        && d.estado == 'nueva'
        /*
         * Y `revision` entera en null: nadie nace revisado.
         *
         * **El `.get(clave, 'x')` es lo que rechaza la clave ausente**, y por eso
         * acá no va `hasAll`: el default es un centinela que **no es `null`**, así
         * que una clave que falta no puede pasar el `== null`. Ausente y `null`
         * dejan de ser lo mismo sin necesidad de una cláusula aparte — que además
         * no se podría mutar, y sería la clase de cláusula muerta que este archivo
         * persigue dos funciones más arriba.
         *
         * En `revisionValida()` sí va `hasAll`, y ahí sí frena: los dos campos
         * opcionales del update se chequean con `== null` **contra un default
         * `null`**, porque ahí `null` es un valor legítimo que un admin manda.
         */
        && d.revision.keys().hasOnly(['porUid', 'en', 'actividadId', 'motivo'])
        && d.revision.get('porUid', 'x') == null && d.revision.get('en', 'x') == null
        && d.revision.get('actividadId', 'x') == null
        && d.revision.get('motivo', 'x') == null
        /*
         * **`!esAdmin()` y no `request.auth == null`** — lo corrigió el
         * `auditor-privacidad`, y las dos cosas que arregla son de las que no se
         * ven venir:
         *
         *  - crear una cuenta está al alcance de cualquiera con la API key
         *    pública, así que con `== null` alguien **logueado sin el claim** no
         *    podría proponer, y el rechazo no diría por qué;
         *  - y el dueño, que **es** admin y va a tener sesión persistida en el
         *    mismo origen, no podría usar su propio formulario público. Que hoy
         *    funcionaría depende de que `/proponer` no inicialice Auth
         *    (`getAuth()` es lazy en `firebase-client.ts`) — un acoplamiento que
         *    nadie escribió y que se rompe el día que esa página llame a `auth()`.
         *
         * La propiedad que se quiere es la misma —una propuesta anónima no puede
         * decir que la cargó el panel, ni al revés— apoyada en la autoridad real
         * en vez de en un proxy.
         *
         * **Se revisó con el rol nuevo y se deja como está** (B-888). La
         * tentación era cambiarlo por `!esDelPanel()`, ya que un publicador
         * también es el panel. No: hoy el `allow create` de abajo exige `esAdmin()`
         * —así que un publicador no puede crear **ninguna** propuesta, de ningún
         * origen— y esa cláusula sería **letra muerta**, exactamente lo que este
         * archivo persigue dos funciones más arriba. Y el día que B-836 abra el
         * `create` anónimo, `!esDelPanel()` reintroduciría el bug que el
         * `auditor-privacidad` arregló acá, con otra cuenta: un publicador con
         * sesión no podría usar el formulario público, que es algo que va a hacer
         * como cualquier persona. Lo que la cláusula tiene que impedir —que una
         * propuesta de afuera se presente como cargada por el panel— lo sigue
         * impidiendo la rama de al lado, que exige `esAdmin()` para `origen:
         * 'panel'`.
         */
        && ((d.origen == 'formulario-publico' && !esAdmin())
             || (d.origen == 'panel' && esAdmin()))
        // Con `request.time` el cliente no puede antedatar la propuesta.
        && d.creadoEn == request.time;
    }

    /*
     * El único cambio que un admin puede hacerle a una propuesta: **moverla de
     * estado y dejar constancia de quién la revisó**.
     *
     * Mismo patrón que `reintentoValido()`/`resueltoValido()`: `affectedKeys`
     * acotado. Y la razón de fondo es la misma que hace que la bandeja valga:
     * un admin **no puede editar el contenido** de una propuesta. Si hay que
     * corregir el título, se corrige en la actividad que sale de ella — así la
     * propuesta queda como prueba de qué se pidió (§4.3 del PRD).
     *
     * `porUid == request.auth.uid` para que un admin no pueda firmar la revisión
     * a nombre del otro, igual que `reportadoPor.uid` en `/reportes`.
     */
    function revisionValida() {
      let d = request.resource.data;
      let previo = resource.data;
      return d.diff(previo).affectedKeys().hasOnly(['estado', 'revision'])
        && d.diff(previo).affectedKeys().hasAny(['estado'])
        && d.estado in ['nueva', 'en-revision', 'aceptada', 'rechazada']
        && d.revision.keys().hasOnly(['porUid', 'en', 'actividadId', 'motivo'])
        && d.revision.keys().hasAll(['porUid', 'en', 'actividadId', 'motivo'])
        && d.revision.get('porUid', '') == request.auth.uid
        && d.revision.get('en', null) == request.time
        && (d.revision.get('actividadId', null) == null
             || (d.revision.get('actividadId', '') is string
                  && d.revision.get('actividadId', '').size() <= 200))
        && (d.revision.get('motivo', null) == null
             || (d.revision.get('motivo', '') is string
                  && d.revision.get('motivo', '').size() <= 500));
    }

    match /propuestas/{id} {
      // La bandeja la miran los admin, como `/reportes`. Y **solo** ellos: el
      // documento lleva el contacto de quien propuso, que es el primer dato
      // personal de un tercero que el proyecto guarda (§7 del PRD).
      //
      /*
       * **Ese "solo ellos" ahora también excluye al publicador** (B-888), y acá es
       * donde más importa: es el único dato personal **de un tercero** que el
       * proyecto guarda, y una propuesta no es de nadie del panel —no hay un
       * `createdBy` propio que la vuelva «lo suyo»—. Revisar propuestas es
       * decidir qué entra al catálogo, que es justamente la autoridad que este rol
       * no tiene: sus propias actividades salen sin revisión, las de terceros no.
       * Las tres cláusulas de esta colección se quedan en `esAdmin()`.
       */
      allow read: if esAdmin();

      /*
       * ✅ **LA PRIMERA ESCRITURA ANÓNIMA DEL PROYECTO, Y ESTÁ ABIERTA** desde el
       * 2026-09-11 (B-896, paso 2).
       *
       * ── Qué la sostiene, que son las cinco capas de B-836 y ninguna sobra ──
       *
       *   1. **App Check exigiendo en Firestore** — `ENFORCED` desde el
       *      2026-09-10 (B-836a paso 6). Es la capa que acota el **volumen**, que
       *      es lo único que `propuestaValida()` no puede: la regla mira la forma
       *      de una escritura, no cuántas llegan, y cada una es una escritura
       *      facturada en un proyecto Blaze.
       *   2. **`propuestaValida()`** — conjunto exacto de campos y topes de largo.
       *   3. **Los topes de tamaño y forma** de cada campo, acá mismo.
       *   4. **El honeypot y el tiempo mínimo de tipeo**, en `FormularioPublico`.
       *   5. **El barrido programado** de `functions/retencion.js`, que además es
       *      lo que honra DEC-13: la propuesta rechazada y la que nadie tocó se
       *      borran a los 30 días, documento **e** imagen.
       *
       * ── Y la foto NO entra por acá ────────────────────────────────────────
       * El flyer va por `subirFlyerDePropuesta`, una callable con
       * `enforceAppCheck: true` que sanea del lado del servidor y escribe con el
       * Admin SDK (**B-896**). `storage.rules` para `propuestas/` quedó en
       * `create: if false` **para todo cliente** — o sea que esta puerta se abrió
       * y la de Storage se cerró más de lo que estaba. Era lo que trababa el
       * anuncio de `/proponer`: exigir App Check en Storage es **por servicio y no
       * por path**, y se llevaba puestas todas las lecturas públicas de imágenes
       * del sitio (B-872).
       *
       * ── El testigo, y cuál NO es ──────────────────────────────────────────
       * El que se pone rojo si esta línea se toca es
       * `tests/propuestas.integracion.test.ts` — el control positivo «un anónimo
       * crea una propuesta bien formada» más los negativos que siguen valiendo
       * (documento mal formado, `revision` puesta a mano, `origen: 'panel'`).
       *
       * **`escritura-anonima.integracion.test.ts` NO es el testigo de esta
       * puerta**, aunque lo parezca: prueba con un documento sonda
       * (`{ hola: 'mundo' }`) que `propuestaValida()` rechaza con la puerta
       * abierta o cerrada. Es testigo de la **lista**, no de la puerta — por eso
       * `'propuestas'` se agrega a mano a `COLECCIONES_ABIERTAS`, para que abrir
       * una puerta sea un diff visible y no un efecto colateral.
       *
       * Un admin sigue pudiendo crear una propuesta a mano (`origen: 'panel'`),
       * que es un camino del PRD y no un andamio: sirve para cargar lo que llega
       * por DM.
       */
      allow create: if propuestaValida();

      allow update: if esAdmin() && revisionValida();

      // Borrar es de la Function de retención (30 días, DEC-13 / B-838), que
      // corre con el Admin SDK y no pasa por estas reglas. Un admin no borra una
      // propuesta desde el panel: rechazarla es un estado, no una desaparición.
      allow delete: if false;
    }

    /*
     * ══ LIBRERÍAS — B-831, PRD 2 ═════════════════════════════════════════
     *
     * `docs/prd/02-librerias.md` § 3. Es el **primero de los tres directorios**
     * y el que valida el motor compartido (`src/lib/directorios.ts`, B-834): el
     * ciclo de vida —tres estados, el grafo de transiciones, qué escribe la
     * máquina— vive allá y los campos viven en `src/types/libreria.ts`. Acá vive
     * lo único que no se puede saltear: **la autorización y la forma**.
     *
     * ── La colección no lleva `/guia/` ───────────────────────────────────
     * El documento es `/librerias/{id}` y la página se sirve en
     * `/guia/librerias/{slug}`: `/guia/` es navegación y SEO, no modelo
     * (`prd/README.md`).
     *
     * ── Dos clases de contacto en el mismo documento ─────────────────────
     * `instagram`, `whatsapp`, `web` y `mail` son **públicos y ése es el punto**
     * —la ficha existe para que la gente le escriba a la librería—, y
     * `contactoDeQuienCargo` es **interno**, como el `contacto` de una propuesta
     * (§ 8 del PRD, §5.1 del `CLAUDE.md`). Que convivan es justo la condición
     * donde una proyección por spread filtra un campo, y por eso la lectura de
     * esta colección está cerrada: **una regla no proyecta** (D-128).
     *
     * La forma se valida acá y no solo en el schema de zod por lo mismo que
     * `propuestaValida()`: del otro lado va a haber un anónimo, así que **el
     * schema se saltea con un `curl` y esto no**. Los números son los de
     * `src/types/libreria.ts` y los ata `tests/librerias.test.ts`, que lee este
     * archivo.
     *
     * ── Lo que estas reglas NO pueden hacer, dicho y no supuesto ─────────
     * **No iteran una lista** (B-842), así que de `imagenes` se acota la cantidad
     * y el tipo, nunca la forma de cada fila: un `curl` puede mandar cuatro mapas
     * arbitrarios. Lo que lo hace aceptable es lo mismo que allá — **nada de una
     * librería llega a una salida pública sin que un admin la publique**, y la
     * URL de cada imagen la tiene que sanear la proyección (`urlSegura` /
     * `imagenesPublicables`), que es donde el proyecto ya decidió que se sanea.
     *
     * **Y no verifican que el barrio exista** en `/opciones/barrio`: eso pediría
     * un `get()` desde la regla, facturado en cada evaluación (el mismo descarte
     * que `reservaValida()` hace con `actividadId`). Lo que sí se acota es su
     * **forma** de slug, y el criterio de aceptación 5 del PRD —«un anónimo no
     * puede crear un barrio nuevo»— lo sostiene `/opciones/*`, cuyo `write` sigue
     * en `esAdmin()`. El daño máximo de un slug inventado es una ficha cuyo
     * barrio no resuelve etiqueta, visible en la bandeja antes de publicarse.
     */
    function geoDeLibreriaValida(g) {
      /*
       * Mismo rango que `sedeSchema` (`lib/schema.ts`): una latitud de 200 no
       * existe, y un lat/lng invertido pone la librería del otro lado del mundo
       * — en un `GeoCoordinates` de JSON-LD, o sea en Google.
       *
       * **Sin `hasAll` y sin `is number`, y las dos ausencias son deliberadas.**
       * El primer borrador tenía las dos y **la mutación las delató**: sacarlas
       * dejaba la suite entera en verde.
       *
       *  - `hasAll`: la clave ausente la agarra el `.get(clave, 999.0)`, cuyo
       *    default está fuera de los dos rangos a propósito.
       *  - `is number`: un valor de otro tipo —`'-34.6'`, `true`, `null`— no se
       *    puede comparar con `>=`, así que lo rechaza igual el rango de abajo.
       *    Es **exactamente** el caso del `is string` que se borró de
       *    `usuarioValido()` y de `reservaValida()`, y por el mismo motivo.
       *
       * Una cláusula que no puede fallar en una regla de seguridad es peor que
       * ninguna: se lee como load-bearing y el que venga la va a cuidar en vez
       * de mirar la que sí frena. Los casos están en
       * `tests/librerias.integracion.test.ts` («una geo rota»).
       */
      return g == null || (
        g.keys().hasOnly(['lat', 'lng'])
        && g.get('lat', 999.0) >= -90 && g.get('lat', 999.0) <= 90
        && g.get('lng', 999.0) >= -180 && g.get('lng', 999.0) <= 180
      );
    }

    function contactoDeLibreriaValido(c) {
      /*
       * El contacto de quien cargó la ficha: **interno, no sale nunca**.
       *
       * `null` es legítimo —una ficha cargada por un admin no tiene a quién
       * repreguntarle—, y por eso el obligatorio del formulario público vive en
       * `libreriaPublicaFormSchema` y no acá: una regla no sabe si del otro lado
       * hay una persona completando un formulario.
       *
       * Sin `hasAll`, por el mismo motivo que el `contacto` de una propuesta:
       * las dos claves son obligatorias y las exigen sus propias cotas
       * (`via in [...]` falla con `''`, y `valor.size() >= 3` también).
       */
      return c == null || (
        c.keys().hasOnly(['via', 'valor'])
        && c.get('via', '') in ['mail', 'whatsapp', 'instagram']
        && c.get('valor', '') is string
        && c.get('valor', '').size() >= 3
        && c.get('valor', '').size() <= 200
      );
    }

    /**
     * ¿El slug de esta ficha ya no se puede tocar? **Trampa 10 del §13.**
     *
     * Una dirección publicada está en Instagram, en un mail y en el índice de
     * Google: cambiarla es un 404 sin aviso y el SEO perdido. Se congela **al
     * publicar** y no al crear, porque corregirle el slug al nombre que llegó mal
     * escrito es justo el trabajo de la bandeja.
     *
     * La pregunta de verdad es «¿estuvo publicada **alguna vez**?» (B-285): una
     * ficha que se publicó y se despublicó volvió a `pendiente`, y mirar solo el
     * estado actual le devolvería el slug editable — o sea la puerta de atrás del
     * mismo candado. Por eso se mira primero la marca `publicadaAlgunaVez`, que
     * **hoy no escribe nadie** (la va a escribir un trigger con el Admin SDK) y
     * cuya ausencia se contesta con el estado, que es el comportamiento actual.
     *
     * Una diferencia con `slugBloqueado` (`lib/directorios.ts`) que conviene
     * tener escrita: allá la marca **gana** sobre el estado (`?? `), acá se
     * suman con un `||`. O sea que un documento imposible —`publicado` con la
     * marca en `false`— acá **queda congelado** y allá no. Falla cerrada, que es
     * la dirección que corresponde cuando lo que está en juego es una URL
     * indexada.
     */
    function slugDeLibreriaCongelado(previo) {
      return previo.get('publicadaAlgunaVez', false) == true
        || previo.get('estado', '') == 'publicado';
    }

    /**
     * La forma de una librería: lo que tiene que valer en **toda** escritura,
     * create y update. Lo que solo vale al crearse está en `libreriaValida()`.
     */
    function formaDeLibreria() {
      let d = request.resource.data;
      let obligatorios = ['nombre', 'slug', 'descripcion', 'imagenes', 'direccion', 'barrio',
                          'ciudad', 'geo', 'instagram', 'whatsapp', 'web', 'mail',
                          'contactoDeQuienCargo', 'estado', 'origen', 'searchText',
                          'creadoEn', 'revision'];
      /*
       * `publicadaAlgunaVez` está en `hasOnly` y **no** en `hasAll`: es un campo
       * opcional que escribe un trigger con el Admin SDK, así que hoy está
       * ausente en todos los documentos. Sin él en `hasOnly`, el día que el
       * trigger lo escriba **toda edición del panel se rompería** —
       * `request.resource.data` es el documento resultante, no el diff, así que
       * el campo viajaría en cada `update`. Que un cliente no lo pueda **mover**
       * lo garantizan el `create` y el `update` de abajo, cada uno con su
       * cláusula.
       *
       * Los siete campos que pueden ser `null` (descripcion, geo, instagram,
       * whatsapp, web, mail, contactoDeQuienCargo) están igual en `hasAll`: se
       * leen con `.get(clave, null)`, así que ausente y `null` serían
       * indistinguibles y la presencia hay que declararla. Es la misma asimetría
       * que `propuestaValida()` documenta para sus cinco mapas anidados.
       */
      return d.keys().hasOnly(obligatorios.concat(['publicadaAlgunaVez']))
        && d.keys().hasAll(obligatorios)
        && d.nombre is string && d.nombre.size() >= 2 && d.nombre.size() <= 80
        /*
         * El slug **es** la URL pública, así que su alfabeto es el de `slugify`:
         * el mismo `RE_SLUG` que el schema, atado por el test.
         *
         * **Sin `size() >= 1`, y la mutación es la que lo decidió**: el `+` del
         * patrón ya exige al menos un carácter, así que el piso no podía fallar.
         * Vale igual para `barrio` (mismo patrón) y para `web` (`^https?://.*`
         * son ocho caracteres como mínimo), y **no** para `ciudad`, que no tiene
         * `matches` — por eso ésa sí lo lleva. Es la misma poda que se les hizo a
         * `usuarioValido()` y a `reservaValida()`.
         */
        && d.slug is string && d.slug.size() <= 120
        && d.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && (d.get('descripcion', null) == null
             || (d.descripcion is string && d.descripcion.size() <= 1000))
        && d.imagenes is list && d.imagenes.size() <= 4
        && d.direccion is string && d.direccion.size() >= 4 && d.direccion.size() <= 160
        // El mismo slug de `/opciones/barrio` que usan las actividades (§ 2 del
        // PRD): con otro alfabeto, el hub de barrio no cruza las dos cosas.
        && d.barrio is string && d.barrio.size() <= 80
        && d.barrio.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && d.ciudad is string && d.ciudad.size() >= 1 && d.ciudad.size() <= 80
        && geoDeLibreriaValida(d.geo)
        /*
         * Los tres contactos públicos que terminan en un `href` de una página
         * **indexada**, con su forma acotada acá y no solo en el schema:
         *
         *  - el handle de Instagram, con el alfabeto real de Instagram — una
         *    barra adentro arma una URL a otra cuenta (es lo que ya cuida
         *    `handleInstagram`);
         *  - el WhatsApp **solo con dígitos**, porque de él sale un
         *    `wa.me/<digitos>` y un formato libre publica un link roto;
         *  - la web con esquema `http`/`https` obligatorio: sin esto, un
         *    `javascript:…` guardado se apoya en que el saneador de la ficha
         *    esté puesto, y la defensa la estaría poniendo el consumidor.
         */
        && (d.get('instagram', null) == null
             || (d.instagram is string && d.instagram.matches('^[A-Za-z0-9._]{1,30}$')))
        && (d.get('whatsapp', null) == null
             || (d.whatsapp is string && d.whatsapp.matches('^[0-9]{8,15}$')))
        && (d.get('web', null) == null
             || (d.web is string && d.web.size() <= 500
                  && d.web.matches('^https?://.*')))
        && (d.get('mail', null) == null
             || (d.mail is string && d.mail.size() >= 3 && d.mail.size() <= 200))
        && contactoDeLibreriaValido(d.contactoDeQuienCargo)
        /*
         * Los tres estados son los de `ESTADOS_DIRECTORIO` (`lib/directorios.ts`),
         * atados por el test: dos vocabularios del mismo ciclo de vida se separan
         * sin que nada falle (clase de B-88).
         *
         * **Y `origen` NO lleva su `in [...]`, aunque lo pida la simetría**: la
         * mutación lo delató como letra muerta. En el `create` el vocabulario lo
         * fuerza la cláusula de coherencia de `libreriaValida()` —que exige uno de
         * los dos valores exactos según quién escriba—, y en el `update` lo fuerza
         * `d.origen == previo.origen`. Un `in` acá no podría fallar nunca.
         */
        && d.estado in ['pendiente', 'publicado', 'rechazado']
        // Derivado por `formALibreria` con `normalize` (§6). Nadie lo tipea: el
        // tope es lo que impide que un campo que nadie mira sirva de bolsa.
        && d.searchText is string && d.searchText.size() <= 2000
        && d.revision.keys().hasOnly(['porUid', 'en', 'motivo'])
        && d.revision.keys().hasAll(['porUid', 'en', 'motivo'])
        && (d.revision.get('motivo', null) == null
             || (d.revision.get('motivo', '') is string
                  && d.revision.get('motivo', '').size() <= 500));
    }

    function libreriaValida() {
      let d = request.resource.data;
      return formaDeLibreria()
        // El estado inicial lo fuerza la REGLA y no el cliente. Sin esto, un
        // `curl` publica su propia librería y la bandeja no sirve para nada
        // (§1 del `prd/README.md`).
        && d.estado == 'pendiente'
        /*
         * Y `revision` entera en null: nadie nace revisado. Con `.get(clave,
         * 'x')` —un centinela que **no es `null`**— la clave ausente tampoco
         * pasa, así que acá no hace falta declarar la presencia aparte. Es el
         * mismo idiom que `propuestaValida()`.
         */
        && d.revision.get('porUid', 'x') == null
        && d.revision.get('en', 'x') == null
        && d.revision.get('motivo', 'x') == null
        // La marca de la trampa 10 no puede nacer puesta: una ficha que nace
        // «ya estuvo publicada» nace con el slug congelado y con el candado del
        // lado de afuera.
        && d.get('publicadaAlgunaVez', false) == false
        /*
         * **`!esAdmin()` y no `request.auth == null`**, por lo mismo que
         * `propuestaValida()`: crear una cuenta está al alcance de cualquiera con
         * la API key pública, y el dueño —que es admin y tiene sesión en el mismo
         * origen— tiene que poder usar su propio formulario público.
         *
         * Hoy el `allow create` de abajo exige `esAdmin()`, así que la rama de
         * `'formulario-publico'` **no es alcanzable** y lo que esta cláusula
         * sostiene es la otra mitad: un admin no puede hacer pasar su carga por
         * una ficha que llegó de afuera. Eso es lo que hace que `origen`
         * signifique algo el día que la puerta se abra, y tiene su caso.
         */
        && ((d.origen == 'formulario-publico' && !esAdmin())
             || (d.origen == 'panel' && esAdmin()))
        // Con `request.time` el cliente no puede antedatar la ficha.
        && d.creadoEn == request.time;
    }

    /**
     * Lo que un admin **sí** puede cambiarle a una librería ya creada.
     *
     * **Al revés que una propuesta**, acá el contenido se edita, y no es una
     * inconsistencia: una propuesta es *lo que alguien pidió* y queda como prueba
     * de eso; una ficha de directorio **es la entrada del catálogo**, y
     * completarla y corregirla es exactamente el trabajo de la bandeja (§ 5 del
     * PRD, y `contenidoEditable` de `lib/directorios.ts`).
     *
     * Lo que no se puede, y cada cosa es una cláusula:
     */
    function libreriaActualizable() {
      let d = request.resource.data;
      let previo = resource.data;
      return formaDeLibreria()
        // **Reescribir la historia**: de cuándo es la ficha y por dónde entró no
        // se editan. Sin esto, una ficha que llegó de afuera se puede repintar
        // como cargada por el panel, y `origen` deja de significar nada.
        && d.creadoEn == previo.creadoEn
        && d.origen == previo.origen
        // **Mover la marca de la trampa 10.** La escribe un trigger con el Admin
        // SDK; un cliente que pudiera bajarla a `false` tendría de vuelta el
        // slug de una ficha que ya está en Google.
        && d.get('publicadaAlgunaVez', false) == previo.get('publicadaAlgunaVez', false)
        // **Cambiar la dirección web de algo ya publicado** — trampa 10.
        && (!slugDeLibreriaCongelado(previo) || d.slug == previo.slug)
        /*
         * **Publicar de un saque lo que ya se había descartado.** Es la única
         * arista que le falta al grafo de `TRANSICIONES` (`lib/directorios.ts`),
         * y es toda la razón por la que ese grafo existe: publicar directo desde
         * `rechazado` mete al sitio una ficha **sin que nadie la haya vuelto a
         * leer**, que es lo que la bandeja existe para impedir. Reabrir
         * (`→ pendiente`) y publicar desde ahí son dos clicks y un estado en el
         * medio donde la ficha se mira de nuevo.
         *
         * Va acá y no solo en el panel por el motivo de siempre: que la UI
         * esconda un botón no impide nada a quien abra la consola de Firebase con
         * su propia sesión.
         */
        && (previo.get('estado', '') != 'rechazado' || d.estado != 'publicado')
        /*
         * **Y si la revisión se toca, se firma con el uid propio y con la hora
         * del servidor.** Igual que `revisionValida()` en `/propuestas` y que
         * `reportadoPor.uid` en `/reportes`: nadie firma a nombre de otro, y
         * nadie antedata.
         *
         * Condicionada a que `revision` esté en el diff, y eso es deliberado: una
         * edición de contenido que no mueve el estado no tiene por qué reescribir
         * la firma de quien la revisó, y exigirlo obligaría a refirmar en cada
         * corrección de un typo.
         */
        && (!d.diff(previo).affectedKeys().hasAny(['revision'])
             || (d.revision.get('porUid', '') == request.auth.uid
                  && d.revision.get('en', null) == request.time));
    }

    match /librerias/{id} {
      /*
       * ── `get` y `list` se deciden por separado, y los dos dan `esAdmin()` ──
       *
       * Dar la misma respuesta no los vuelve la misma decisión, y escribirlos
       * juntos esconde que los motivos son distintos.
       *
       * **`get`: porque una regla no proyecta** (D-128). Es todo-o-nada por
       * documento: un `get` abierto a «las publicadas» entregaría el documento
       * **entero** —`contactoDeQuienCargo`, el motivo del rechazo, el
       * `storagePath` de cada imagen— y no la vista que `toPublic` decide. Es
       * exactamente la puerta que D-128 cerró en `/actividades`, y acá el
       * documento tiene adentro el dato personal de un tercero. Y no hace falta
       * abrirlo: el sitio es estático y hace **cero** lecturas de Firestore
       * (§2.5) — lee el `librerias.json` que produce el build con el Admin SDK.
       *
       * **`list`: porque `read` incluye `list`** (trampa 13, la misma que en
       * Storage). Un `list` abierto no entrega un documento: entrega **el
       * directorio entero de una sentada** —las pendientes, las descartadas, y
       * todos los contactos internos cargados hasta hoy—, que es la cosecha más
       * barata que existe. Un id impredecible no protege nada si te dan la lista.
       *
       * **Y la trampa 7, que es el motivo por el que ninguno de los dos se
       * condiciona por contenido.** La forma «abrilo solo para las publicadas»
       * sería `resource.data.estado == 'publicado'`, y eso hace dos cosas: sigue
       * entregando el documento entero (lo de arriba) **y** obliga a que toda
       * query traiga el `where` correspondiente o Firestore la rechace **entera**,
       * no recortada. Con las dos cláusulas en `esAdmin()` no hay condición sobre
       * `resource.data`, así que ninguna query del panel puede fallar por eso.
       *
       * ── Y el `publicador` (B-888): **nada, y es una decisión escrita** ─────
       * Las cinco cláusulas de esta colección se quedan en `esAdmin()`, con el
       * mismo argumento con el que `/propuestas` se lo cierra, que acá vale
       * doble:
       *
       *  1. **No hay «lo suyo».** El rol contesta «¿de quién es este documento?»
       *     y una librería no tiene `createdBy`: es la ficha de un tercero. Sin
       *     esa pregunta, el rol no tiene nada que recortar.
       *  2. **Decidir qué entra al catálogo es la autoridad que este rol no
       *     tiene.** Sus propias actividades salen sin revisión; las fichas de
       *     terceros no son suyas.
       *  3. **Y el documento lleva el contacto de un tercero**, igual que una
       *     propuesta.
       *
       * Si algún día el dueño quiere que un publicador cargue librerías, el
       * camino no es abrir esto: es que la ficha tenga `createdBy` y que la rama
       * acotada se escriba como la de `/actividades`. Mientras tanto está cerrado
       * **acá** y no en la UI, que es lo único que vale.
       */
      allow get: if esAdmin();
      allow list: if esAdmin();

      /*
       * ⚠️ **ACÁ VA LA SEGUNDA ESCRITURA ANÓNIMA DEL PROYECTO, Y TAMPOCO ESTÁ
       * ABIERTA.**
       *
       * El `create` público de `/guia/librerias/sumar` es el punto del PRD y está
       * cerrado a propósito. Lo que falta **no es código**, y no es lo mismo que
       * bloqueaba a `/propuestas`: Firestore ya está en `ENFORCED` (B-836a paso
       * 6). Lo que falta es **B-872** — Storage sigue en `UNENFORCED` porque su
       * métrica de App Check marca 99% sin verificar y la sospecha, todavía sin
       * confirmar, es que ese 99% son **las lecturas públicas de imágenes** por
       * URL de descarga, que no llevan token de App Check ni pueden llevarlo. Si
       * el enforcement las bloqueara, se caen todas las imágenes del sitio.
       *
       * Y el formulario de una librería **sube una foto** (§ 5 del PRD, DEC-11),
       * así que abrir este `create` sin resolver eso deja una de dos cosas, las
       * dos malas: un formulario que acepta el texto y rechaza la foto, o un
       * **endpoint de subida anónimo sin App Check**, que es exactamente lo que
       * las cinco capas de B-836 existen para que no pase.
       *
       * **Para abrirla**, y en este orden:
       *   1. **B-872 contestado** —¿el enforcement de Storage alcanza a las URLs
       *      de descarga?— y App Check **exigiendo también en Storage**,
       *      verificado en la consola;
       *   2. el prefijo `librerias/` en `storage.rules`, con su `create` acotado
       *      a tipo, tamaño y cantidad, y su `get`/`list` decididos — **en el
       *      mismo commit que el punto 3**: una subida que no puede terminar en un
       *      documento es un objeto huérfano, y un documento que no puede traer su
       *      imagen es DEC-11 a medias (es el orden que dejó escrito
       *      `storage.rules` para `propuestas/`);
       *   3. borrar el `esAdmin() &&` de la línea de abajo;
       *   4. **el testigo que se pone rojo es
       *      `tests/librerias.integracion.test.ts`**, el caso «un anónimo no
       *      puede crear una librería, ni con el documento perfecto». Y hay que
       *      agregar `'librerias'` a `COLECCIONES_ABIERTAS` de
       *      `tests/escritura-anonima.integracion.test.ts`, que es lo que hace que
       *      abrir una puerta sea un diff visible y no un efecto colateral.
       *      **Ojo: ese archivo NO se pone rojo solo** — prueba las escrituras con
       *      un documento sonda (`{ hola: 'mundo' }`), que `formaDeLibreria()`
       *      rechaza por `hasOnly` con la puerta abierta o cerrada, así que es
       *      testigo de la **lista** de colecciones y no de esta puerta;
       *   5. el honeypot y el tiempo mínimo de tipeo van en el componente, y el
       *      barrido programado de la bandeja en su Function. Son las otras capas
       *      de B-836 y ninguna reemplaza a ésta.
       *
       * Mientras tanto un admin sí puede cargar una librería a mano, que es un
       * camino del PRD (§ 1, la tercera puerta) y no un andamio.
       */
      allow create: if esAdmin() && libreriaValida();

      allow update: if esAdmin() && libreriaActualizable();

      /*
       * **Borrar sí, y es una decisión.** Al revés que `/propuestas`, donde el
       * `delete` está en `false` porque la borra la Function de retención
       * (DEC-13): acá esa Function **no existe todavía**, así que una ficha
       * descartada conserva el `contactoDeQuienCargo` de quien la cargó para
       * siempre y el borrado manual es lo único con lo que se puede honrar un
       * «borrame». Que ese plazo falte está anotado en el backlog.
       *
       * El camino normal sigue siendo `rechazado` —la ficha queda como registro
       * de que alguien la propuso—, y borrar es para el alta de spam y para el
       * pedido de una persona. **No hay subcolección `/versiones` acá**, así que
       * un borrado no se recupera: es lo mismo que el `delete` del admin en
       * `/actividades`, que sí la tiene, con una red menos.
       */
      allow delete: if esAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
