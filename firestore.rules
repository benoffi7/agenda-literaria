rules_version = '2';

// §5.3 — el custom claim `admin` se setea una vez con el Admin SDK
// (scripts/set-admin-claim.mjs). Sin ese claim no hay escritura posible.
service cloud.firestore {
  match /databases/{database}/documents {

    // `token.get('admin', false)` y no `token.admin`: leer una clave ausente de
    // un map en las reglas es un evaluation error, no `false`. Con el acceso
    // directo, cualquier usuario sin el claim hace fallar la regla y el cliente
    // recibe "evaluation error" en lugar de un permission-denied limpio.
    function esAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }

    match /actividades/{id} {
      /*
       * Solo el admin lee — D-128, desvío deliberado del §5.3 del `CLAUDE.md`,
       * que prescribía `allow read: if resource.data.estado == 'publicado'`.
       *
       * Esa condición era coherente con §2.4/§2.5 (el público hace UN fetch de
       * `events.json` y CERO lecturas de Firestore), pero dejaba la puerta
       * abierta igual — y **las reglas son todo-o-nada por documento: no
       * filtran campos**. Con la API key web —pública por diseño y versionada
       * en `.env.production` de un repo público— un anónimo hacía la query con
       * el `where('estado','==','publicado')` y recibía el documento ENTERO:
       * `online.url` con `urlPublica:false`, `difusion.notas` y `arrobar`, la
       * URL del material con `publico:false`, `createdBy`/`updatedBy`,
       * `sesiones[].calendarEventId` y `imagenes[].storagePath`. Es la lista
       * completa del §5.1, salteando `toPublic` por completo.
       *
       * O sea: toda la maquinaria de proyección estaba cuidando una puerta que
       * tenía otra abierta al lado. Se reprodujo contra el emulador antes de
       * tocar esto, y los dos `it` de `actividades.integracion.test.ts` lo
       * fijan — uno por documento y otro por query, porque son dos permisos
       * distintos.
       *
       * No rompe nada: el panel siempre está logueado, y el sitio público
       * (B-01) sirve el `events.json` que produce el build con el Admin SDK. Si
       * alguna vez hace falta lectura en vivo desde el cliente, el camino **no**
       * es volver a esta regla: es sacar los campos privados del documento (una
       * subcolección `privado/{doc}` con `allow read: if esAdmin()`), porque una
       * regla no puede proyectar.
       *
       * Nota del emulador, que importa para escribir los tests: cuando la
       * **lectura** se deniega, el `message` de la `FirebaseError` no es
       * "Missing or insufficient permissions" —eso es de las escrituras— sino la
       * traza de evaluación (`false for 'get' @ L50`), o directamente
       * `Property estado is undefined on object` cuando la regla no se puede
       * evaluar. Pero el **`code` sí es `permission-denied`** en todos esos
       * casos, y es `unavailable` si el emulador no está.
       *
       * Por eso los tests de lectura afirman el `code` y no el mensaje
       * (`rechazadaPorPermisos` en `actividades.integracion.test.ts`): un
       * `rejects.toThrow()` pelado lo satisface un emulador caído, y un matcher
       * por mensaje falla contra la traza. Se probó en las dos direcciones.
       */
      allow read: if esAdmin();
      allow write: if esAdmin();

      // §12 — historial de versiones. Solo lo escribe la Function con Admin SDK.
      match /versiones/{version} {
        allow read: if esAdmin();
        allow write: if false;
      }
    }

    match /opciones/{campo} {
      allow read: if true;

      // §4.3 — `aprobada` decide si una opción creada con "Otro" entra al
      // desplegable de las demás cuentas. Aprobar es, a nivel de reglas, una
      // escritura más de este documento: la autoridad para aprobar es el claim
      // `admin`, el mismo que ya habilita crear la opción y editar cualquier
      // actividad.
      //
      // No se intenta una regla más fina (ej.: "solo el dueño puede aprobar")
      // porque las reglas no pueden inspeccionar qué elemento del array cambió:
      // `valores` llega como un array de maps y no hay forma de compararlo
      // elemento por elemento contra el anterior. Una regla que no puede
      // verificar lo que promete es peor que no tenerla. Si en algún momento
      // hace falta separar "quien carga" de "quien valida", el camino es un
      // claim aparte (`curador`) y mover la aprobación a un solo campo o a un
      // documento propio, que sí es verificable.
      allow write: if esAdmin();
    }

    function reporteValido() {
      let d = request.resource.data;
      let campos = ['tipo', 'titulo', 'descripcion', 'pasos', 'severidad', 'actividad',
                    'contexto', 'reportadoPor', 'estado', 'intentos', 'github', 'error',
                    'creadoEn'];
      return d.keys().hasOnly(campos) && d.keys().hasAll(campos)
        && d.tipo in ['bug', 'sugerencia']
        && d.titulo is string && d.titulo.size() >= 6 && d.titulo.size() <= 120
        && d.descripcion is string && d.descripcion.size() >= 15 && d.descripcion.size() <= 4000
        && (d.pasos == null || (d.pasos is string && d.pasos.size() <= 2000))
        && (d.severidad == null || d.severidad in ['me-bloquea', 'molesta', 'menor'])
        && (d.actividad == null || d.actividad.keys().hasOnly(['id', 'titulo']))
        && d.contexto.keys().hasOnly(['versionPanel', 'navegador', 'ventana',
                                      'zonaHoraria', 'url', 'pantalla'])
        // B-363 — `contexto.pantalla` es el único subcampo de `contexto` que la
        // Function pasa por `desSlug()` ANTES del saneador (`functions/reportes.js`).
        // `desSlug` reemplaza `-` por espacios, y eso le desafina los patrones al
        // saneador: `https://mi-org.zoom.us/…` → `Https://mi org.zoom.us/…` ya no
        // matchea `LINK_REUNION` (que no cruza un espacio), y se publicaría
        // legible. `severidad` no corre este riesgo porque ya está acotado arriba
        // por `in [...]`; `pantalla` no lo estaba. Acotarlo acá es más simple que
        // reordenar el armado del issue (`redactar` corre sobre el cuerpo entero,
        // no por campo — D-197), y cierra la única vía por la que ese campo podía
        // traer algo que no sea uno de los cinco valores fijos de `PANTALLAS`
        // (`src/types/reporte.ts`). `.get()` con default porque `contexto` no
        // fuerza `pantalla` con `hasAll`, así que puede venir ausente.
        && d.contexto.get('pantalla', 'listado')
             in ['listado', 'nueva-actividad', 'editar-actividad', 'encuentros', 'otra']
        // §5.1 — el uid queda acá y no sale al issue. Que sea el propio evita
        // que un admin cargue un reporte a nombre del otro.
        && d.reportadoPor.keys().hasOnly(['uid', 'email'])
        && d.reportadoPor.uid == request.auth.uid
        && d.estado == 'pendiente'
        && d.intentos == 0
        && d.github == null
        && d.error == null
        // Con `request.time` el cliente no puede antedatar el reporte.
        && d.creadoEn == request.time;
    }

    /**
     * B-31 — el único cambio que el panel puede hacerle a un reporte ya creado:
     * volver a intentar la publicación de uno que quedó en `error`.
     *
     * El ciclo de vida sigue siendo de la Function; esto no lo abre, agrega
     * **una** transición y la deja verificable en la regla misma. Cinco
     * condiciones, y cada una tapa una forma de hacer daño:
     *
     *  - `estado == 'error'` de partida: no se puede "reintentar" algo que está
     *    en vuelo (`enviando`) ni ya publicado, que es como se crearían dos
     *    issues del mismo reporte.
     *  - `github == null` de partida: defensa en profundidad de lo mismo. Si el
     *    documento ya tiene número de issue, no hay nada que reintentar.
     *  - solo cambian cuatro campos: el texto del reporte —lo que va al repo
     *    PÚBLICO— no se puede editar por este camino. Reintentar publica lo
     *    mismo que se guardó, no otra cosa.
     *  - `intentos == 0`: es lo que hace que el reintento sirva. `decidirAccion`
     *    de `functions/reportes.js` ignora un reporte con los intentos
     *    agotados, así que mover solo el estado dejaría el botón sin efecto en
     *    el caso más común (falló tres veces por un token vencido).
     *  - `error == null`: se limpia el mensaje del fallo anterior, que si no
     *    queda contradiciendo al estado nuevo en la pantalla.
     *
     * Borrar sigue prohibido: un reporte es el pedido de una persona, y el
     * panel no tiene por qué poder hacerlo desaparecer.
     */
    function reintentoValido() {
      let d = request.resource.data;
      let previo = resource.data;
      // Todo con `.get(clave, default)` y no con acceso directo, por el mismo
      // motivo que `esAdmin()`: leer una clave ausente de un map es un
      // evaluation error, no `false`. `actualizadoEn` es el caso real —es
      // opcional en el documento— y `github` lo sería en un documento anterior
      // al campo.
      //
      // Igual que en `/actividades`, el emulador sigue reportando "evaluation
      // error" en algunos rechazos: evalúa ramas que la conjunción no necesita.
      // Es cosmético —deniegan igual, y los siete tests de B-31 lo fijan— y no
      // se arregla escribiéndolo de otra forma: se probó con `.get()` y con
      // `keys().hasAll()`, y el log dice lo mismo.
      return previo.get('estado', '') == 'error'
        && previo.get('github', null) == null
        && d.diff(previo).affectedKeys()
             .hasOnly(['estado', 'intentos', 'error', 'actualizadoEn'])
        && d.get('estado', '') == 'pendiente'
        && d.get('intentos', -1) == 0
        && d.get('error', 'no vino') == null
        && d.keys().hasAll(['actualizadoEn'])
        && d.actualizadoEn == request.time;
    }

    /**
     * B-580 — el segundo (y único otro) cambio que el panel puede hacerle a un
     * reporte ya creado: marcarlo resuelto, o reabrirlo.
     *
     * El dueño pidió que la pantalla de reportes deje de mostrar todo lo que
     * se cargó alguna vez y refleje solo los abiertos. La alternativa —que un
     * issue cerrado en GitHub marque el reporte solo— es la sync
     * GitHub→Firestore que el dueño **descartó** en esta misma tanda (B-30,
     * "dejamos como está") y que además el §2.1 del `CLAUDE.md` ya prohíbe
     * para Calendar por el mismo motivo (D-310): Firestore es la única fuente
     * de verdad, y quien cierra el reporte es un admin desde el panel.
     *
     * Mismo criterio que `reintentoValido`, con `resuelto` en vez del ciclo
     * de vida de envío:
     *
     *  - solo pueden cambiar `resuelto` y `actualizadoEn`: el texto, el
     *    estado de envío y el resto del documento no se tocan por acá.
     *  - `resuelto` tiene que estar de verdad en el diff (`hasAny`), y no
     *    solo `actualizadoEn` — una escritura que no cambia nada de lo que
     *    esta regla habilita no tiene motivo para pasar por ella.
     *  - `resuelto` tiene que ser un booleano: cualquier otro tipo (string,
     *    número) rompería el filtro `!r.resuelto` del panel de formas raras.
     *  - sin condición sobre el `resuelto` PREVIO, a propósito: al revés que
     *    el reintento (que es una transición de un solo sentido,
     *    `error`→`pendiente`), acá las dos direcciones son válidas — marcar
     *    resuelto y reabrir son la misma operación de escritura, y el botón
     *    del panel manda el valor que corresponda.
     */
    function resueltoValido() {
      let d = request.resource.data;
      let previo = resource.data;
      return d.diff(previo).affectedKeys().hasOnly(['resuelto', 'actualizadoEn'])
        && d.diff(previo).affectedKeys().hasAny(['resuelto'])
        && d.get('resuelto', null) is bool
        && d.keys().hasAll(['actualizadoEn'])
        && d.actualizadoEn == request.time;
    }

    // Reportes del panel (bugs y sugerencias). Los crea un admin desde
    // /admin y la Function `reporteAIssue` los publica como issue de GitHub.
    //
    // Las reglas son la autorización real: por eso la Function es un trigger
    // de Firestore y no un `onCall` que tenga que revalidar el claim a mano.
    //
    // Se valida la forma del documento, no solo quién escribe: el reporte
    // termina en un repo PÚBLICO, y el estado inicial es lo que decide si la
    // Function lo toma. Sin esto, un admin distraído (o un script con su
    // token) podría crear un reporte que nace "creado", o con los intentos
    // gastados, y nunca se publicaría.
    match /reportes/{id} {
      // Los dos admins leen todos los reportes: es una bandeja compartida.
      allow read: if esAdmin();
      allow create: if esAdmin() && reporteValido();
      // El ciclo de vida (estado, intentos, github) lo mueve la Function con el
      // Admin SDK, que no pasa por estas reglas. Las únicas dos excepciones son
      // el reintento de B-31 y marcar/reabrir resuelto de B-580, cada una
      // acotada arriba a los campos que le corresponden.
      allow update: if esAdmin() && (reintentoValido() || resueltoValido());
      allow delete: if false;
    }

    /*
     * Lo que el backend calcula y el panel mira. Dos documentos hoy:
     *
     *  - `rebuild` — el flag de rebuild pendiente del §8;
     *  - `analitica-sitio` — el resumen diario de GA4 y Search Console
     *    (B-374/B-373), y **éste lleva contenido**: los rankings de páginas del
     *    sitio y las consultas con las que Google nos muestra, o sea texto que
     *    una persona tipeó. Por eso la lectura es de admin y no de cualquiera.
     *
     * `write: if false` para todos, incluido el admin: los dos los escribe el
     * Admin SDK desde una Cloud Function, que no pasa por reglas. Así nadie
     * puede pisarle al tablero un número inventado.
     *
     * `tests/sistema.integracion.test.ts` lo fija contra el emulador — era la
     * única colección con contenido sin test de reglas, y aflojar esto a
     * `if true` no rompía nada.
     */
    match /sistema/{doc} {
      allow read: if esAdmin();
      allow write: if false;
    }

    /*
     * ══ PROPUESTAS DE ORGANIZADORES — B-830 ══════════════════════════════
     *
     * `docs/prd/01-propuestas-de-organizadores.md`. Es la colección que va a
     * aceptar **la primera escritura anónima del proyecto**, y por eso este
     * bloque es el más delicado del archivo.
     *
     * **Hoy el `create` sigue cerrado a admin, a propósito.** Ver el comentario
     * del `allow create` más abajo: falta que App Check esté **exigiendo**
     * (B-836a, pasos del dueño), y sin eso abrir la puerta es publicar un
     * endpoint de escritura a Firestore sin nada que frene a un script.
     * `tests/escritura-anonima.integracion.test.ts` es el testigo: mientras esté
     * verde, nadie escribe sin el claim.
     *
     * La forma se valida acá y no solo en el schema de zod, por lo mismo que
     * `reporteValido()` y con más razón: del otro lado hay un anónimo, así que
     * **el schema se saltea con un `curl` y esto no**. Los números son los mismos
     * de `src/types/propuesta.ts` y los ata `tests/propuestas.test.ts`, que lee
     * este archivo.
     *
     * Lo que las reglas **no pueden** hacer, y hay que saberlo: no iteran una
     * lista, así que de `incluye` se puede acotar la cantidad y **no** el largo
     * de cada elemento. El tope de tamaño del documento (1 MB) es el techo real,
     * y la defensa de fondo es que **nada de una propuesta llega a una salida
     * pública sin que un admin la convierta en actividad**.
     */
    function fechasValidas(fechas) {
      // `hasOnly` sobre las claves de cada fila no se puede sin iterar, así que
      // lo que se acota es la cantidad y el tipo. La forma de cada fila la
      // valida el schema, y el daño posible queda en «el admin ve una fila
      // rara» — nada se publica sin que la convierta.
      return fechas is list && fechas.size() >= 1 && fechas.size() <= 12;
    }

    function lugarValido(lugar) {
      return lugar == null || (
        lugar.keys().hasOnly(['nombre', 'direccion', 'barrio'])
        && lugar.get('nombre', '') is string && lugar.get('nombre', '').size() <= 200
        && lugar.get('direccion', '') is string && lugar.get('direccion', '').size() <= 200
        && lugar.get('barrio', '') is string && lugar.get('barrio', '').size() <= 200
      );
    }

    function imagenValida(imagen) {
      /*
       * Una URL de afuera **o** un objeto de nuestro bucket, nunca las dos
       * (DEC-11). Dos mitades, y cada una tapa una forma distinta:
       *
       *  - **`hasOnly`** rechaza el mapa con las **dos** claves: ninguno de los
       *    dos `hasOnly` acepta la clave del otro. Verificado por mutación —
       *    sacarlo deja pasar `{url, storagePath}`.
       *  - **`.get(clave, '')` + `size() >= 1`** rechaza el mapa **vacío** y la
       *    cadena vacía. Va con `.get()` y no con acceso directo por el mismo
       *    motivo que `esAdmin()`, dicho al principio de este archivo: leer una
       *    clave ausente de un map es un *evaluation error*, no `false`. El
       *    error deniega igual, así que la regla «funcionaría» — pero por el
       *    camino equivocado, con un mensaje que no dice nada y sin una cláusula
       *    que se pueda mutar para comprobarla.
       *
       * **Acá hubo dos cláusulas que no hacían nada**, y las encontró la
       * verificación por mutación, no la lectura: primero un `size() == 1` con un
       * comentario que decía que era lo que hacía excluyente al par (falso: eso lo
       * hace `hasOnly`), y después un `hasAll` puesto para tapar el mapa vacío
       * (falso también: lo tapaba el error de evaluación). Sacar cualquiera de las
       * dos dejaba los casos en verde. Una cláusula que no puede fallar en una
       * regla de seguridad es peor que ninguna: se lee como load-bearing, y el que
       * venga la va a cuidar en vez de mirar la que sí frena.
       */
      return imagen == null || (
        (imagen.keys().hasOnly(['url'])
          && imagen.get('url', '') is string
          && imagen.get('url', '').size() >= 1 && imagen.get('url', '').size() <= 500)
        || (imagen.keys().hasOnly(['storagePath'])
          && imagen.get('storagePath', '') is string
          && imagen.get('storagePath', '').size() >= 1
          && imagen.get('storagePath', '').size() <= 500)
      );
    }

    function propuestaValida() {
      let d = request.resource.data;
      let campos = ['titulo', 'descripcion', 'fechas', 'modalidad', 'lugar', 'organizador',
                    'arancel', 'inscripcion', 'incluye', 'incluyeOtro', 'imagen',
                    'contacto', 'estado', 'creadoEn', 'origen', 'revision'];
      return d.keys().hasOnly(campos) && d.keys().hasAll(campos)
        && d.titulo is string && d.titulo.size() >= 6 && d.titulo.size() <= 120
        && d.descripcion is string
        && d.descripcion.size() >= 15 && d.descripcion.size() <= 4000
        && fechasValidas(d.fechas)
        && d.modalidad in ['presencial', 'virtual', 'las-dos']
        && lugarValido(d.lugar)
        && d.organizador.keys().hasOnly(['nombre', 'instagram'])
        && d.organizador.nombre is string
        && d.organizador.nombre.size() >= 2 && d.organizador.nombre.size() <= 200
        && (d.organizador.instagram == null || (d.organizador.instagram is string
              && d.organizador.instagram.size() <= 200))
        && d.arancel.keys().hasOnly(['tipo', 'notas'])
        // §4.1 — solo los tres `fijo: true`. Las demás se eligen desde el panel,
        // porque crear una opción es escribir en `/opciones/*`, que es de lectura
        // pública y viaja al `events.json` (§4.2 del PRD).
        && d.arancel.tipo in ['gratis', 'a-la-gorra', 'arancelado']
        && (d.arancel.notas == null || (d.arancel.notas is string
              && d.arancel.notas.size() <= 200))
        && d.inscripcion.keys().hasOnly(['requiere', 'comoDice'])
        && d.inscripcion.requiere is bool
        && (d.inscripcion.comoDice == null || (d.inscripcion.comoDice is string
              && d.inscripcion.comoDice.size() <= 500))
        && d.incluye is list && d.incluye.size() <= 12
        && (d.incluyeOtro == null || (d.incluyeOtro is string
              && d.incluyeOtro.size() <= 200))
        && imagenValida(d.imagen)
        // El contacto de quien propone: interno, no sale nunca (§5.1, §7 del PRD).
        && d.contacto.keys().hasOnly(['via', 'valor'])
        && d.contacto.via in ['mail', 'whatsapp', 'instagram']
        && d.contacto.valor is string
        && d.contacto.valor.size() >= 3 && d.contacto.valor.size() <= 200
        // El estado inicial lo fuerza la REGLA y no el cliente. Sin esto, un
        // `curl` marca su propia propuesta como aceptada y la bandeja no sirve
        // para nada (§1 del `prd/README.md`).
        && d.estado == 'nueva'
        // Y `revision` entera en null: nadie nace revisado.
        && d.revision.keys().hasOnly(['porUid', 'en', 'actividadId', 'motivo'])
        && d.revision.porUid == null && d.revision.en == null
        && d.revision.actividadId == null && d.revision.motivo == null
        // El origen tiene que coincidir con quién escribe: una propuesta anónima
        // no puede decir que la cargó el panel, ni al revés. Es lo que hace que
        // el `origen` sirva para algo cuando se abra el `create`.
        && ((d.origen == 'formulario-publico' && request.auth == null)
             || (d.origen == 'panel' && esAdmin()))
        // Con `request.time` el cliente no puede antedatar la propuesta.
        && d.creadoEn == request.time;
    }

    /*
     * El único cambio que un admin puede hacerle a una propuesta: **moverla de
     * estado y dejar constancia de quién la revisó**.
     *
     * Mismo patrón que `reintentoValido()`/`resueltoValido()`: `affectedKeys`
     * acotado. Y la razón de fondo es la misma que hace que la bandeja valga:
     * un admin **no puede editar el contenido** de una propuesta. Si hay que
     * corregir el título, se corrige en la actividad que sale de ella — así la
     * propuesta queda como prueba de qué se pidió (§4.3 del PRD).
     *
     * `porUid == request.auth.uid` para que un admin no pueda firmar la revisión
     * a nombre del otro, igual que `reportadoPor.uid` en `/reportes`.
     */
    function revisionValida() {
      let d = request.resource.data;
      let previo = resource.data;
      return d.diff(previo).affectedKeys().hasOnly(['estado', 'revision'])
        && d.diff(previo).affectedKeys().hasAny(['estado'])
        && d.estado in ['nueva', 'en-revision', 'aceptada', 'rechazada']
        && d.revision.keys().hasOnly(['porUid', 'en', 'actividadId', 'motivo'])
        && d.revision.porUid == request.auth.uid
        && d.revision.en == request.time
        && (d.revision.actividadId == null || (d.revision.actividadId is string
              && d.revision.actividadId.size() <= 200))
        && (d.revision.motivo == null || (d.revision.motivo is string
              && d.revision.motivo.size() <= 500));
    }

    match /propuestas/{id} {
      // La bandeja la miran los admin, como `/reportes`. Y **solo** ellos: el
      // documento lleva el contacto de quien propuso, que es el primer dato
      // personal de un tercero que el proyecto guarda (§7 del PRD).
      allow read: if esAdmin();

      /*
       * ⚠️ **ACÁ VA LA PRIMERA ESCRITURA ANÓNIMA DEL PROYECTO, Y TODAVÍA NO ESTÁ
       * ABIERTA.**
       *
       * Lo que falta no es código: es que **App Check esté exigiendo**
       * (B-836a, pasos del dueño — publicar, verificar los dominios permitidos
       * de la clave, verificar que lleguen peticiones y recién ahí exigir). Sin
       * enforcement, borrar el `esAdmin() &&` de acá abajo publica un endpoint de
       * escritura a Firestore que **nada** frena: `propuestaValida()` acota la
       * forma, no el volumen, y cada escritura es una escritura facturada en un
       * proyecto Blaze (§2 del `prd/README.md`).
       *
       * **Para abrirla**, y en este orden:
       *   1. App Check exigiendo, verificado en la consola;
       *   2. borrar `esAdmin() &&` de la línea de abajo;
       *   3. `tests/escritura-anonima.integracion.test.ts` se pone **rojo** —es
       *      su trabajo— y ahí se agrega `'propuestas'` a `COLECCIONES_ABIERTAS`
       *      con su motivo, que es lo que hace que abrir una puerta sea un diff
       *      visible y no un efecto colateral;
       *   4. el honeypot y el tiempo mínimo de tipeo van en el componente, y el
       *      barrido programado de la bandeja en su Function. Son las otras tres
       *      capas de B-836 y ninguna reemplaza a ésta.
       *
       * Mientras tanto un admin sí puede crear una propuesta a mano
       * (`origen: 'panel'`), que es un camino del PRD y no un andamio: sirve para
       * cargar lo que llega por DM.
       */
      allow create: if esAdmin() && propuestaValida();

      allow update: if esAdmin() && revisionValida();

      // Borrar es de la Function de retención (30 días, DEC-13 / B-838), que
      // corre con el Admin SDK y no pasa por estas reglas. Un admin no borra una
      // propuesta desde el panel: rechazarla es un estado, no una desaparición.
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
