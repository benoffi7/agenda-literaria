rules_version = '2';

// B-167 (segunda tajada) — las imágenes propias de la galería, DEC-7b y DEC-7c.
//
// ── Por qué este archivo existe, y no alcanza con el schema ────────────────
// El schema de zod (`src/lib/schema.ts`) valida lo que el **panel** manda. Acá
// abajo hay una sesión de Firebase con el claim `admin` y el SDK de Storage
// cargado: cualquiera que abra la consola del navegador puede llamar a
// `uploadBytes` con un archivo de 80 MB y saltearse el formulario entero. Por eso
// DEC-7b pide las dos defensas, y por eso el tamaño se verifica **acá también**.
//
// Lo que este archivo NO puede verificar, y está dicho para que no se lea como
// olvido: **el tope de 4 imágenes por actividad**. Las reglas de Storage evalúan
// una operación sobre un objeto y no pueden contar los objetos de un prefijo ni
// leer la actividad que los va a referenciar. El tope de 4 vive solo en el
// schema (`MAXIMO_IMAGENES`), y el daño de saltearlo es una actividad con cinco
// imágenes que el panel no deja guardar — no un objeto de 80 MB en el bucket.
service firebase.storage {
  match /b/{bucket}/o {

    /*
     * ══ EL ROL `publicador` DE B-888, Y POR QUÉ SOLO `create` ════════════
     *
     * La tajada 1 dejó este archivo sin el rol, así que un publicador **no podía
     * subir la imagen de su actividad**, y dejó escritas las dos salidas. La
     * tajada 2 eligió la segunda, y la elección es de las que conviene leer antes
     * de "mejorarla".
     *
     * ── El problema, que sigue siendo cierto ──────────────────────────────
     * El prefijo `imagenes/{archivo}` es **plano y el nombre es un uuid opaco**
     * (B-206 #1, porque al subir todavía no hay actividad a la cual agrupar). O
     * sea que **el objeto no dice de quién es**, y las reglas de Storage no
     * pueden leer el documento de Firestore que lo va a referenciar: con este
     * prefijo, «solo las suyas» **no es expresable**.
     *
     * ── Por qué NO se agrupó por uid (D-660) ──────────────────────────────
     * `imagenes/{uid}/{archivo}` es lo único que haría verificable «lo suyo», y
     * cuesta lo que ningún beneficio de acá paga:
     *
     *  - **la URL de descarga lleva el path adentro** (B-206 #1), así que mover
     *    un objeto le cambia la URL — y esas URLs están escritas en documentos
     *    publicados, en el `events.json`, en `og:image` y en el `srcset` del
     *    sitio. Migrar objetos sería reescribir documentos;
     *  - arrastra `rutaDeImagen`, `rutaDeMiniatura`/`urlDeMiniatura` (que derivan
     *    `miniaturas/<id>.jpg` del nombre del original), el trigger de
     *    optimización y `limpiarImagenesHuerfanas`, que solo recorre dos
     *    prefijos;
     *  - y obliga a que el `match` de este prefijo pase de un segmento a un
     *    comodín de ruta completa, que es —con todas las letras, y está anotado
     *    en el docblock de `miniaturas/` de más abajo y **verificado por
     *    `tests/imagenes-function.test.ts`, que falla si ese patrón aparece en
     *    este archivo**— el día en que la trampa 13 se reabre sin que nada avise.
     *
     * ── El publicador SOLO CREA, y la guarda es `resource == null` ───────
     * Un publicador no puede **pisar** un objeto que ya existe, y esto importa
     * más de lo que parece: el path viaja adentro de la URL de descarga (B-206
     * #1) y `get` es público, así que el uuid del flyer de cualquier actividad
     * publicada **es conocible**. Sin esta guarda, abrir la subida al rol sería
     * dejarle reemplazar el flyer de cualquiera.
     *
     * **La guarda es `resource == null` explícito, y NO la separación
     * `create`/`update`**, que es lo que uno escribiría primero. Se probó contra
     * el emulador el 2026-09-11 y **no sirve**: con `allow create: if true` y
     * `allow update: if false`, una segunda subida sobre el mismo objeto **pasa**.
     * O sea que el emulador no clasifica el overwrite como `update`. La
     * documentación dice que en producción sí, pero eso es un **supuesto sobre la
     * plataforma que no podemos verificar**, y este proyecto ya se quemó con uno
     * (el `size() > 0` de `usuarioValido()` en `firestore.rules`, que el
     * `auditor-privacidad` marcó y resultó falso). Una guarda que no se puede
     * probar no es una guarda: se lee como load-bearing y nadie sabe si frena.
     *
     * `resource == null` **sí** se comporta igual en el emulador —probado en las
     * dos direcciones— y lo fija `tests/storage-reglas.integracion.test.ts`.
     *
     * `delete` se queda en `esAdmin()` y **no le cuesta nada**: el panel no borra
     * de Storage desde ningún lado —no hay un solo `deleteObject` en `src/`—, los
     * huérfanos los barre `limpiarImagenesHuerfanas` con el Admin SDK. O sea que
     * lo que el rol «no puede» es algo que nadie puede.
     *
     * `list` se queda en `esAdmin()` por la trampa 13: enumerar el prefijo
     * entrega también los flyers de las actividades en borrador de todo el mundo.
     *
     * **Lo que esto acepta, dicho al derecho:** el prefijo sigue sin decir de
     * quién es cada objeto, así que un publicador puede dejar objetos huérfanos
     * (los barre el script) y puede subir tantos como el formulario le deje. Lo
     * que no puede es pisar, borrar ni enumerar.
     */
    function esPublicador() {
      return request.auth != null && request.auth.token.get('publicador', false) == true;
    }

    // Igual que en `firestore.rules`: `token.get('admin', false)` y no
    // `token.admin`, porque leer una clave ausente de un map es un evaluation
    // error y no `false` — el cliente recibiría "evaluation error" en lugar de
    // un permission-denied limpio.
    function esAdmin() {
      return request.auth != null
        && request.auth.token.get('admin', false) == true
        // **El mismo `!esPublicador()` que `firestore.rules`, y por el mismo
        // motivo** (B-888, D-650): cada regla de abajo se lee
        // `esAdmin() || (esPublicador() && …)` y `||` cortocircuita, así que sin
        // esto un token con los **dos** claims —que solo sale de un error del
        // operador tocando la consola a mano— pasaría como admin y el rol nuevo
        // no se ejercería nunca. Cae del lado acotado, que es la dirección en la
        // que conviene fallar. Sin esta línea los dos archivos dirían cosas
        // distintas sobre el mismo token, que es la clase de B-88.
        && !esPublicador();
    }

    // Los dos tipos que el panel sabe limpiar de metadatos sin recomprimir
    // (`sinMetadatos` en `src/lib/imagenes-archivo.ts`). WebP y AVIF quedaron
    // afuera a propósito: su contenedor lleva EXIF/XMP y todavía no hay quien se
    // lo saque, así que aceptarlos sería publicar la geolocalización de la foto.
    // Vuelven a entrar con la Function de DEC-7d, que recomprime todo.
    function tipoAceptado() {
      return request.resource.contentType in ['image/jpeg', 'image/png'];
    }

    // DEC-7b — 3 MB. Es el mismo número que `MAXIMO_BYTES` en
    // `src/lib/imagenes.ts`, y los ata `tests/storage-reglas.integracion.test.ts`
    // subiendo de verdad contra el emulador.
    function tamanoAceptado() {
      return request.resource.size <= 3 * 1024 * 1024;
    }

    // ── Las imágenes propias de la galería ──────────────────────────
    //
    // **Un solo prefijo plano, con el nombre del archivo opaco.** El nombre es el
    // id de la fila de la galería, que ya es un uuid generado en el cliente
    // (`nuevaImagenId()`, trampa 2). Eso es lo que hace barata la decisión de
    // B-206 #1: la URL de descarga lleva el path adentro, así que el path es
    // público de hecho — y un path que es un uuid no dice absolutamente nada. No
    // se agrupa por actividad justamente porque **al subir todavía no hay
    // actividad**: una actividad nueva no tiene id hasta que se guarda.
    match /imagenes/{archivo} {
      // Público **por objeto, no por prefijo**, y la distinción es la que
      // sostiene toda la decisión de B-206 #1.
      //
      // `get` abierto es el punto: estas imágenes van al sitio y a `og:image`, y
      // el token de `getDownloadURL()` deja de ser lo que protege el objeto — que
      // es lo que hace inofensivo que ese token viaje en el HTML.
      //
      // `list` **no**, y no alcanza con no escribirlo: `allow read` incluye las
      // dos, y con `read: if true` un `listAll(ref(storage, 'imagenes'))`
      // **anónimo devuelve el bucket entero** (verificado contra el emulador,
      // no deducido). Ahí el path opaco deja de comprar nada: no hace falta
      // adivinar un uuid si te los dan en una lista, y adentro están también las
      // fotos de las actividades que todavía están en borrador.
      allow get: if true;
      allow list: if esAdmin();

      // `create` y `update` separados de `delete` a propósito: en un borrado
      // `request.resource` es null y `request.resource.size` sería un evaluation
      // error, o sea un borrado legítimo denegado por un motivo confuso.
      // **La marca de la Function no se puede subir desde un cliente** — B-220,
      // D-175, y lo encontró el `auditor-privacidad`.
      //
      // `optimizarImagen` corta cuando el objeto ya trae `optimizada` en su
      // `customMetadata`: es la guarda anti-recursión (trampa 12). Pero ese mapa
      // lo elige **quien sube**, así que sin esta línea alcanzaba un
      //
      //   uploadBytes(ref, archivo, { customMetadata: { optimizada: '1' } })
      //
      // desde la consola del navegador para que el trigger se salteara entero, y
      // el JPEG quedara público **con su APP1 y su GPS adentro**. La capa que
      // este frente presenta como «la que no se puede saltear» se salteaba con
      // una línea en la misma consola que motiva su existencia.
      //
      // Es la tercera defensa del mismo párrafo de DEC-7b: el tamaño y el tipo
      // se verifican acá porque el cliente se puede saltear, y la marca también.
      //
      // **No reabre el loop:** la Function escribe con el Admin SDK, que pasa por
      // encima de las reglas, así que sigue pudiendo poner la marca. Lo ata
      // `tests/imagenes-function.test.ts`, que lee `MARCA_OPTIMIZADA` del fuente
      // de la Function y la busca acá — dos lados que derivan el mismo nombre por
      // separado son la clase de B-88.
      //
      // **B-888, tajada 2: suben los dos roles, y el publicador solo crea.** Las
      // cuatro cláusulas de forma son las mismas para los dos —un rol nuevo no
      // relaja el tipo, el tamaño, el nombre ni la marca de la Function— y lo
      // único que cambia es la última línea: el publicador necesita además que el
      // objeto **no exista**.
      //
      // `resource == null` y **no** la separación `allow create` / `allow update`,
      // que es lo que uno escribe primero y que acá no sirve: se probó contra el
      // emulador y el overwrite entra por `create`. El razonamiento completo, con
      // la prueba, está en el docblock del principio del archivo.
      allow create, update: if tipoAceptado()
        && tamanoAceptado()
        && archivo.matches('^img_[A-Za-z0-9_-]+[.](jpg|png)$')
        && (request.resource.metadata == null
            || !('optimizada' in request.resource.metadata))
        && (esAdmin() || (esPublicador() && resource == null));

      // Nadie borra desde el panel —no hay un solo `deleteObject` en `src/`— y
      // los huérfanos los barre `limpiarImagenesHuerfanas` con el Admin SDK. Se
      // queda en `esAdmin()` porque abrirlo sería dejar borrar la foto de
      // cualquiera que conozca el uuid, que con la URL pública es conocible.
      allow delete: if esAdmin();
    }

    // ── Las miniaturas que deriva la Function de B-220 (DEC-7d) ─────
    //
    // **Hermano de `imagenes/` y no `imagenes/miniaturas/`, y es una decisión.**
    // La regla de arriba matchea `match /imagenes/{archivo}` —un solo
    // segmento—, así que un `list` de ese prefijo cae en el `deny` del
    // catch-all. Anidar acá abajo obligaría a escribir `{ruta=**}`, y el test de
    // integración de estas reglas tiene anotado, desde antes de que la Function
    // existiera, que ése es el día en que la trampa 13 se reabre sin que nada
    // avise: «el día que alguien escriba `{ruta=**}` —el patrón más natural, y
    // el que va a hacer falta si mañana hay `imagenes/miniaturas/`— la lectura
    // sigue andando, todo lo demás sigue verde, y esto se abre».
    match /miniaturas/{archivo} {
      // Mismo criterio que el original: `get` abierto porque la miniatura va al
      // sitio, `list` cerrado porque enumerar el prefijo entrega también las
      // imágenes de las actividades en borrador (trampa 13). Y acá el `list`
      // importa **más** que en `imagenes/`: el nombre de la miniatura se
      // **deriva** del del original (`rutaDeMiniatura`), así que enumerar
      // `miniaturas/` es enumerar `imagenes/` con otro nombre.
      allow get: if true;
      allow list: if esAdmin();

      // **Nadie escribe acá desde un cliente, ni siquiera un admin.** El único
      // que escribe es la Function, con el Admin SDK, que pasa por encima de las
      // reglas. Cerrarlo no es simetría: una miniatura la deriva la Function de
      // un original que ya validamos, y dejar que un cliente ponga bytes
      // arbitrarios en una dirección que el sitio **calcula** sería dejar que
      // elija qué se muestra en la cartelera sin pasar por ninguna validación de
      // tipo ni de tamaño.
      allow write: if false;
    }

    // ── La imagen de una propuesta (B-830 paso 8, DEC-11) ──────────
    //
    // **Es el prefijo donde va a escribir alguien sin login**, y lo que hay
    // adentro **no es público**: una foto que una persona mandó para que la vea
    // **una** no es el flyer de una actividad publicada. Por eso no comparte
    // `match` con `imagenes/` — un solo bloque con dos significados termina con
    // el más permisivo ganando.
    match /propuestas/{archivo} {
      // **`get` para un admin y `list` para nadie**, que es la trampa 13 aplicada
      // al revés que arriba: acá lo que no puede pasar es que se lea desde
      // afuera, ni siquiera con la URL exacta.
      //
      // El PRD pedía «`get` y `list` en `false`» y esto **se desvía a propósito**,
      // con la decisión del dueño del 2026-09-09: con `get` cerrado para todos, el
      // admin no puede ver el flyer que le mandaron, y decidir si acepta depende
      // en parte de mirarlo. La trampa 13 está escrita contra el `read: if true`
      // anónimo —el `listAll()` que devuelve el bucket entero—, no contra la
      // sesión que ya puede leer la propuesta entera en Firestore.
      //
      // `list` **en `false` y no en `esAdmin()`**, que es la diferencia con
      // `imagenes/`: allá enumerar es un lujo que el panel no usa; acá enumerar es
      // «dame todas las fotos que mandaron», y la bandeja nunca lo necesita —
      // llega a cada objeto por el `storagePath` de su documento.
      allow get: if esAdmin();
      allow list: if false;

      // ── EL `create` ESTÁ CERRADO, Y ES LA DECISIÓN — B-896 ──────────
      //
      // **Cerrado a propósito, no a la espera de nada.** Hasta B-896 esta línea
      // decía `esAdmin() && …` y el comentario que estaba acá decía «todavía no
      // está abierta»: el plan era borrar el `esAdmin() &&` el día que App Check
      // estuviera exigiendo, y así dejar entrar al anónimo de `/proponer`. **Ese
      // plan se descartó**, y conviene saber por qué antes de reabrirlo.
      //
      // El plan se apoyaba en exigir App Check en Storage, y **el enforcement de
      // App Check es por servicio, no por path**: no se puede exigir solo para
      // `propuestas/`. Exigirlo en `firebasestorage` lo exige también para las
      // lecturas públicas de imágenes —un GET anónimo del navegador contra la URL
      // de descarga, que no lleva token ni puede llevarlo— y eso **se lleva
      // puestas todas las fotos del sitio** (B-872). O sea: la única forma de
      // atestar esta subida abría un agujero mucho más grande que el que tapaba.
      //
      // **La salida rompe el acoplamiento:** la subida ya no va directo a
      // Storage. Va a una Cloud Function callable con `enforceAppCheck: true`
      // (`functions/flyer-de-propuesta-trigger.js`), que valida la atestación,
      // **vuelve a sanear la imagen del lado del servidor** —el saneado del
      // cliente se puede saltear abriendo la consola del navegador, así que como
      // garantía no valía nada— y escribe el objeto con el Admin SDK, que pasa
      // por encima de estas reglas. El enforcement de `cloudfunctions` es
      // independiente del de Storage y no toca ninguna lectura de imagen.
      //
      // Así que acá no hay una puerta entornada esperando una señal: **no hay
      // ningún cliente que tenga que escribir en este prefijo**, ni anónimo ni
      // admin. `if false` es más fuerte que cualquier condición que pudiéramos
      // escribir, y es lo que hace que abrir `/proponer` no cueste abrir nada.
      //
      // Las cuatro cláusulas de forma que esta regla tenía —tipo, tamaño, nombre
      // y la marca de la Function— **no se perdieron, se mudaron a donde ahora
      // hay algo que chequear**: `functions/flyer-de-propuesta.js`
      // (`TIPOS_ACEPTADOS`, `MAXIMO_BYTES`, `NOMBRE_DE_FLYER`,
      // `metadatosDelFlyer`). Ahí son más fuertes, porque además miran lo que el
      // archivo tiene **adentro**, que es lo único que una regla de Storage nunca
      // pudo ver. Lo ata `tests/propuestas-imagen.test.ts`.
      //
      // **El testigo de que esto no se reabra por descuido** es el caso «nadie
      // sube desde un cliente, ni un admin» de
      // `tests/storage-reglas.integracion.test.ts`: se pone rojo el día que
      // alguien afloje esta línea.
      allow create: if false;

      // **Nadie borra desde un cliente, ni siquiera un admin.** Los borrados que
      // existen son de Functions con el Admin SDK, que pasa por encima de estas
      // reglas: los dos cierres de `borrarImagenAlCerrar` —el rechazo, en el
      // acto, y **la aceptación** (B-863), cuando la copia promovida ya
      // reemplaza al original— y el de la retención (`borrarPropuestasVencidas`,
      // a los 30 días, que a la aceptada no la alcanza porque no vence). Que el
      // panel no pueda borrar es lo que hace que el borrado sea **una
      // consecuencia del estado** y no un botón que alguien puede olvidarse de
      // tocar — y en B-863 eso resultó ser más que una prolijidad: el borrado
      // tiene que ocurrir en el **segundo** momento de la conversión (cuando la
      // actividad ya se guardó, D-600), y un trigger sobre la transición a
      // `aceptada` acierta ese momento por construcción, mientras que un botón
      // del panel habría borrado en el primero.
      allow update, delete: if false;
    }

    // Todo lo demás cerrado. Sin esto, un prefijo nuevo que alguien invente
    // mañana no tiene ninguna regla y Storage deniega — pero deniega también la
    // lectura, y el modo de falla sería una imagen rota sin explicación. Que
    // esté escrito hace que el `deny` sea una decisión y no un descuido.
    match /{ruta=**} {
      allow read, write: if false;
    }
  }
}
